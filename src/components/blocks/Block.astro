---
// Every article block is the same instrument panel: an eyebrow label in
// the top-left and a hairline frame. The variants differ by accent and
// emphasis, not by structure — so a new block type is a few lines.
interface Props {
  label: string;
  tone?: 'neutral' | 'accent' | 'warn' | 'crit' | 'ok';
  emphasis?: boolean;
}
const { label, tone = 'neutral', emphasis = false } = Astro.props;
const TONES: Record<string, string> = {
  neutral: 'var(--line-bright)',
  accent: 'var(--accent)',
  warn: 'var(--status-testing)',
  crit: 'var(--status-broken)',
  ok: 'var(--status-working)',
};
---
<section class:list={['block', { emphasis }]} style={`--block-accent: ${TONES[tone]}`}>
  <p class="eyebrow block-label">{label}</p>
  <div class="block-body"><slot /></div>
</section>

<style>
  .block {
    border-left: 2px solid var(--block-accent);
    padding: var(--sp-3) 0 var(--sp-3) var(--sp-4);
    margin: 0 0 var(--sp-5);
  }
  .block.emphasis { background: var(--bg-1); border: 1px solid var(--line); border-left: 3px solid var(--block-accent); padding: var(--sp-4); }
  .block-label { color: var(--block-accent); margin-bottom: var(--sp-2); }
  .block-body > :global(:last-child) { margin-bottom: 0; }
  .block-body :global(p) { max-width: 68ch; }
</style>
