---
// The /signal/ index. Mirrors the shape of Feed.astro but keyed on tracks
// rather than post types, and deliberately does not reuse it: Feed reads
// CARD_SPEC, which is Record<PostType, …>, and signal entries have no post
// type. Ten duplicated lines of filter CSS beat refactoring the component
// that renders the homepage.
import SignalCard from './SignalCard.astro';
import FeedFilters from '../feed/FeedFilters.astro';

interface Props { entries: any[]; filters: { id: string; label: string }[] }
const { entries, filters } = Astro.props;

// One hide-rule per filter, generated so adding a track stays a data change.
const filterCss = filters
  .map((f) =>
    [
      `.feed-root:has(#filter-${f.id}:checked) .feed-grid > li:not([data-filters~="${f.id}"]){display:none}`,
      `.feed-root:has(#filter-${f.id}:checked):not(:has(.feed-grid > li[data-filters~="${f.id}"])) .feed-empty{display:block}`,
    ].join('\n'),
  )
  .join('\n');
---
<div class="feed-root">
  <details class="filter-disclosure">
    <summary>Filter</summary>
    <FeedFilters filters={filters} />
  </details>

  <ul class="feed-grid">
    {entries.map((entry) => (
      <li data-filters={`${entry.data.track} ${entry.data.source.kind.toLowerCase()}`}>
        <SignalCard entry={entry} />
      </li>
    ))}
  </ul>

  <p class="feed-empty" role="status">Nothing here matches that filter yet.</p>
</div>

<style set:html={filterCss}></style>
<style>
  .feed-empty {
    display: none;
    font-family: var(--font-mono); font-size: var(--step--1);
    color: var(--text-2); letter-spacing: 0.08em; padding: var(--sp-5) 0;
  }
  .filter-disclosure { margin-bottom: var(--sp-5); }
  .filter-disclosure summary {
    cursor: pointer; font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.1em; color: var(--text-1); text-transform: uppercase;
    padding: var(--sp-2) 0; list-style: none;
  }
  .filter-disclosure summary::-webkit-details-marker { display: none; }
  .filter-disclosure summary::before { content: '▸ '; }
  .filter-disclosure[open] summary::before { content: '▾ '; }
  .filter-disclosure[open] summary { color: var(--accent); }
</style>
