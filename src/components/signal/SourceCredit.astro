---
// Attribution, first thing on the page. These entries are compressions of
// somebody else's article or video, so the credit and the link out come
// before anything this site has to say — and the provenance line states
// plainly that a machine wrote the summary.
import { KIND_GLYPH, SIGNAL_ACCENT, sourceHost, type SourceKind } from '../../lib/signal';

interface Props {
  source: { url: string; title: string; author?: string; kind: SourceKind };
  built?: string;
  model?: string;
}
const { source, built, model } = Astro.props;
const host = sourceHost(source.url);
const provenance = [built, model].filter(Boolean).join(' · ');
---
<aside class="credit" style={`--card-accent: var(${SIGNAL_ACCENT})`}>
  <p class="eyebrow">Original source</p>

  <a class="src" href={source.url} target="_blank" rel="noopener nofollow">
    <span class="glyph" aria-hidden="true">{KIND_GLYPH[source.kind]}</span>
    <span class="title">{source.title}</span>
  </a>

  <p class="by">
    {source.author && <><span class="author">{source.author}</span><span class="sep" aria-hidden="true">·</span></>}
    <span>{source.kind}</span>
    {host && <><span class="sep" aria-hidden="true">·</span><span>{host}</span></>}
  </p>

  <p class="provenance">
    This is an AI-written summary of that source, not the source itself and not
    Andrae's own writing. Read the original for the full argument.
    {provenance && <span class="stamp">{provenance}</span>}
  </p>
</aside>

<style>
  .credit {
    border: 1px solid var(--line);
    border-left: 3px solid var(--card-accent);
    background: var(--bg-1);
    padding: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .src {
    display: flex; align-items: baseline; gap: var(--sp-3);
    color: var(--text-0); text-decoration: none; margin: var(--sp-3) 0 var(--sp-2);
  }
  .src .glyph { color: var(--card-accent); font-family: var(--font-mono); }
  .src .title { font-size: var(--step-1); font-weight: 700; line-height: 1.25; }
  .src:hover .title, .src:focus-visible .title {
    color: var(--card-accent); text-decoration: underline; text-underline-offset: 3px;
  }
  .by, .provenance {
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.06em; color: var(--text-2); margin: 0;
  }
  .by { text-transform: uppercase; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .by .author { color: var(--text-1); }
  .sep { opacity: 0.5; }
  .provenance { margin-top: var(--sp-3); text-transform: none; letter-spacing: 0; line-height: 1.5; max-width: 62ch; }
  .stamp { display: block; margin-top: var(--sp-2); color: var(--text-2); opacity: 0.75; }
</style>
