---
// Every signal entry is the same kind of object — a compressed source — so
// they share one frame and one footprint. The track glyph and the source
// kind carry the distinction, not colour or grid span.
import { TRACK_META, KIND_GLYPH, SIGNAL_ACCENT, sourceHost, type SourceKind } from '../../lib/signal';
import { formatDate } from '../../lib/format';
import type { Track } from '../../lib/enums';

interface Props {
  entry: {
    id: string;
    data: {
      title: string; description: string; track: Track; date: Date;
      source: { url: string; title: string; author?: string; kind: SourceKind };
    };
  };
}
const { entry } = Astro.props;
const { data } = entry;
const track = TRACK_META[data.track];
---
<a
  href={`/signal/${entry.id}/`}
  class="card"
  data-frame="hairline"
  style={`--card-accent: var(${SIGNAL_ACCENT})`}
>
  <p class="track">
    <span class="glyph" aria-hidden="true">{track.glyph}</span>
    <span>{track.label}</span>
  </p>

  <h3 class="card-title">{data.title}</h3>

  <p class="card-excerpt">{data.description}</p>

  <div class="card-foot">
    <span class="src">
      <span aria-hidden="true">{KIND_GLYPH[data.source.kind]}</span>
      {data.source.author ?? sourceHost(data.source.url)}
    </span>
    <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
  </div>
</a>

<style>
  .track, .card-foot, .card-foot time {
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.1em; color: var(--text-2);
  }
  .track { display: flex; gap: var(--sp-2); align-items: baseline; margin: 0; }
  .track .glyph { color: var(--card-accent); }
  .card-excerpt {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4;
    overflow: hidden;
  }
  .card-foot { justify-content: space-between; text-transform: uppercase; }
  .src { display: inline-flex; gap: var(--sp-2); align-items: baseline; color: var(--text-1); }
</style>
