---
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="wrap inner">
    <span>BUILT IN PUBLIC · OWN YOUR WORK · LEAVE SIGNAL</span>
    <span>© {year} Andrae Williams</span>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: var(--sp-7); background: var(--bg-1); }
  .inner {
    display: flex; justify-content: space-between; gap: var(--sp-4); flex-wrap: wrap;
    padding: var(--sp-5) var(--sp-4);
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.08em; color: var(--text-2);
  }
</style>
