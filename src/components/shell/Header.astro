---
const NAV = [
  { href: '/projects/', label: 'WORK' },
  { href: '/feed/', label: 'NOTES' },
  { href: '/knowledge/', label: 'KNOWLEDGE' },
  { href: '/lab/', label: 'LAB' },
  { href: '/about/', label: 'ABOUT' },
];
const here = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/">
      <span class="name">ANDRAE WILLIAMS</span>
      <span class="disciplines">Risk · Software · AI</span>
    </a>

    <!-- Checkbox hack, not <details>: a closed <details> hides its
         non-summary content natively in Chromium regardless of
         display:contents on the wrapper, which made the desktop "always
         visible" case unfixable via CSS. A checkbox has no such built-in
         hiding behaviour — visibility here is entirely author CSS, so
         desktop can ignore the checked state completely and mobile can
         gate on it with a plain ~ sibling selector. Still zero JS: the
         checkbox is natively focusable and toggles on Space/click, and
         the label forwards clicks to it. -->
    <input type="checkbox" id="nav-toggle-input" class="nav-toggle-input visually-hidden" />
    <label for="nav-toggle-input" class="nav-toggle" aria-label="Toggle navigation menu">
      <span class="bars" aria-hidden="true"></span>
    </label>

    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button type="button" class="search-trigger" data-open-palette>
      <kbd>⌘K</kbd><span>Search</span>
    </button>
  </div>
</header>

<style>
  /* base.css sets `body > * { z-index: 1 }` globally, which makes every
     direct child of body its own stacking context at the same rank. Two
     equal contexts break ties by DOM order, so <main> (later than the
     header) was painting over the drawer's absolutely positioned nav
     despite its z-index:10 — that z-index only ranked within the
     header's own context, never against main's. Bumping the header
     above main settles it for the whole subtree, drawer included. */
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg-1); position: relative; z-index: 20; }
  .bar {
    display: flex; align-items: center; gap: var(--sp-5);
    padding: var(--sp-3) var(--sp-4); flex-wrap: wrap;
  }
  .wordmark { text-decoration: none; display: grid; gap: 2px; margin-right: auto; }
  .name {
    font-family: var(--font-display); font-size: var(--step-0);
    letter-spacing: 0.06em; color: var(--accent);
  }
  .disciplines {
    font-family: var(--font-mono); font-size: var(--step--1);
    color: var(--text-2); letter-spacing: 0.06em;
  }

  /* Desktop default: the toggle is not rendered and nav lays out exactly
     as a plain <nav> always did — the checkbox's checked state is never
     consulted here. */
  .nav-toggle { display: none; }

  nav ul { display: flex; gap: var(--sp-4); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a {
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.1em; color: var(--text-1); text-decoration: none;
    padding: var(--sp-2) 0; border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--text-0); }
  nav a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }

  .search-trigger {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    background: var(--bg-2); border: 1px solid var(--line);
    color: var(--text-1); font-family: var(--font-mono); font-size: var(--step--1);
    padding: var(--sp-2) var(--sp-3); cursor: pointer; letter-spacing: 0.08em;
  }
  .search-trigger:hover { border-color: var(--accent); color: var(--text-0); }
  kbd { border: 1px solid var(--line-bright); padding: 0 0.3em; font-size: 0.9em; }

  @media (max-width: 52rem) {
    .bar { gap: var(--sp-3); }
    .disciplines { display: none; }

    .nav-toggle {
      display: flex; align-items: center; justify-content: center;
      width: 2.25rem; height: 2.25rem; order: 3;
      background: var(--bg-2); border: 1px solid var(--line); cursor: pointer;
    }
    .nav-toggle:hover { border-color: var(--accent); }
    /* :focus-visible on a visually-hidden input still needs a visible
       cue somewhere, so it's painted on the label it controls — same
       reason the filter chips do this for their hidden radios. */
    .nav-toggle-input:focus-visible + .nav-toggle { outline: 2px solid var(--accent); outline-offset: 2px; }

    .bars, .bars::before, .bars::after {
      display: block; width: 16px; height: 2px; background: var(--text-1);
    }
    .bars { position: relative; }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { top: -5px; }
    .bars::after { top: 5px; }
    .nav-toggle-input:checked + .nav-toggle { border-color: var(--accent); }
    .nav-toggle-input:checked + .nav-toggle .bars { background: transparent; }
    .nav-toggle-input:checked + .nav-toggle .bars::before { top: 0; transform: rotate(45deg); background: var(--accent); }
    .nav-toggle-input:checked + .nav-toggle .bars::after { top: 0; transform: rotate(-45deg); background: var(--accent); }

    /* Collapsed by default below the breakpoint; the checkbox is the
       only thing that reveals it, via a plain sibling selector. */
    nav { order: 4; display: none; }
    .nav-toggle-input:checked ~ nav {
      display: block;
      position: absolute; top: 100%; left: 0; right: 0; z-index: 10;
      background: var(--bg-1); border-bottom: 1px solid var(--line);
      padding: var(--sp-2) var(--sp-4) var(--sp-4);
      max-height: calc(100vh - 100%); overflow-y: auto;
    }
    nav ul { flex-direction: column; gap: 0; }
    nav li { border-bottom: 1px solid var(--line); }
    nav li:last-child { border-bottom: none; }
    nav a { display: block; padding: var(--sp-3) 0; border-bottom: none; }
    nav a[aria-current='page'] { border-left: 2px solid var(--accent); padding-left: var(--sp-3); }
  }
</style>
