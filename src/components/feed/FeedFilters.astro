---
// Filters are radio inputs + :has() — no JavaScript. A reader with JS
// disabled (or still loading) gets working filters, and keyboard/AT
// support comes free from using real form controls.
interface Props { filters: { id: string; label: string }[] }
const { filters } = Astro.props;
const all = [{ id: 'all', label: 'ALL' }, ...filters];
---
<fieldset class="filters">
  <legend class="visually-hidden">Filter the feed</legend>
  {all.map((f, i) => (
    <>
      <input
        type="radio"
        name="feed-filter"
        id={`filter-${f.id}`}
        value={f.id}
        checked={i === 0}
        class="visually-hidden"
      />
      <label for={`filter-${f.id}`}>{f.label}</label>
    </>
  ))}
</fieldset>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--sp-2); border: 0; padding: 0; margin: 0 0 var(--sp-5); }
  .filters label {
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.1em; color: var(--text-1);
    border: 1px solid var(--line); padding: var(--sp-2) var(--sp-3);
    cursor: pointer; user-select: none;
    transition: border-color 150ms ease-out, color 150ms ease-out, background 150ms ease-out;
  }
  .filters label:hover { border-color: var(--line-bright); color: var(--text-0); }
  .filters input:checked + label {
    color: var(--bg-0); background: var(--accent); border-color: var(--accent); font-weight: 700;
  }
  /* The input is visually hidden, so its focus ring has to be painted on
     the label or keyboard users lose the cursor entirely. */
  .filters input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
