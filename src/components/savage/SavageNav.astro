---
// Breadcrumb for the hidden area. The site Header never links here, so
// this is the only way back up the tree.
interface Crumb { href?: string; label: string }
interface Props { trail: Crumb[] }
const { trail } = Astro.props;
---
<nav class="sv-nav" aria-label="Savage Bible">
  <ol>
    <li><a href="/savage/">THE SAVAGE BIBLE</a></li>
    {trail.map((c) => (
      <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .sv-nav { padding-top: var(--sp-4); }
  .sv-nav ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.1em; text-transform: uppercase; }
  .sv-nav li + li::before { content: '/'; color: var(--line-bright); margin-right: var(--sp-2); }
  .sv-nav a { color: var(--text-2); text-decoration: none; }
  .sv-nav a:hover { color: var(--accent); }
  .sv-nav span { color: var(--text-0); }
</style>
