---
const DEFAULT = `DATABASE_URL=postgres://user:hunter2@db.internal:5432/app
API_KEY=sk_live_abc123XYZ
PORT=3000
NODE_ENV=production
`;
---
<div class="scrub-tool" data-tool="secrets">
  <label class="field">
    <span>Paste config</span>
    <textarea class="input" spellcheck="false" rows="10">{DEFAULT}</textarea>
  </label>
  <div class="summary">
    <p class="status"></p>
    <button type="button" class="copy">Copy redacted</button>
  </div>
  <label class="field">
    <span>Redacted output</span>
    <textarea class="output" spellcheck="false" rows="10" readonly></textarea>
  </label>
  <p class="disclaimer">Best-effort — key-name and known-token-format matching, not a guarantee. Review before sharing.</p>
</div>

<script>
  import { redact } from '../../scripts/tools/secrets.js';

  const tools = document.querySelectorAll<HTMLElement>('[data-tool="secrets"]');
  for (const tool of tools) {
    const input = tool.querySelector<HTMLTextAreaElement>('.input')!;
    const output = tool.querySelector<HTMLTextAreaElement>('.output')!;
    const status = tool.querySelector<HTMLElement>('.status')!;
    const copyBtn = tool.querySelector<HTMLButtonElement>('.copy')!;

    const render = () => {
      const { output: redacted, count } = redact(input.value);
      output.value = redacted;
      status.textContent = count ? `${count} value${count > 1 ? 's' : ''} redacted` : 'Nothing matched — review manually before sharing';
      status.dataset.state = count ? 'crit' : 'ok';
    };

    input.addEventListener('input', render);
    copyBtn.addEventListener('click', () => navigator.clipboard?.writeText(output.value));
    render();
  }
</script>

<style>
  .scrub-tool {
    border: 1px solid var(--line);
    background: var(--bg-1);
    padding: var(--sp-5);
    margin: 0 0 var(--sp-5);
    display: grid;
    gap: var(--sp-4);
  }
  .field { display: grid; gap: var(--sp-2); }
  .field span {
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .input, .output {
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-0);
    background: var(--bg-0); border: 1px solid var(--line); padding: var(--sp-3);
    resize: vertical; line-height: 1.5;
  }
  .input:focus, .output:focus { outline: none; border-color: var(--accent); }
  .output { color: var(--status-working); }
  .summary { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .status {
    font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase;
    letter-spacing: 0.06em; margin: 0;
  }
  .status[data-state='crit'] { color: var(--status-broken); }
  .status[data-state='ok'] { color: var(--text-2); }
  .copy {
    background: var(--bg-2); border: 1px solid var(--accent); color: var(--accent);
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.08em;
    padding: var(--sp-2) var(--sp-4); cursor: pointer;
  }
  .copy:hover { background: var(--accent); color: var(--bg-0); }
  .disclaimer { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2); margin: 0; }
</style>
