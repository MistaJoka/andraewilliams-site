---
// The interactive network diagram: click-to-drill-down through the
// stack, from the big picture down to Level 0. Named `network/` rather
// than living under components/knowledge/ because that directory is
// already taken by the unrelated per-page relationship-graph widget
// (KnowledgeGraph.astro) — same route (/knowledge/), different feature.
//
// The entry scene renders here as real, build-time SVG (same technique
// KnowledgeGraph.astro uses) so the page has genuine content with zero
// JS. A module script then progressively enhances it: click-to-drill,
// a breadcrumb trail, and a detail panel replace the static fallback
// list. Unlike AsciiStage there is no heavy asset to gate behind a
// click — this is a few KB of data and string-building, not a WebGL
// bundle — so it enhances immediately rather than waiting to be asked.
import { SCENES, ENTRY_SCENE_ID } from '../../scripts/network/scenes';
import { renderScene } from '../../scripts/network/render';

const entryScene = SCENES[ENTRY_SCENE_ID]!;
const initialSvg = renderScene(entryScene);
---
<section class="network-stage" aria-label="Interactive network diagram">
  <nav class="net-breadcrumb" aria-label="Level" hidden>
    <ol></ol>
  </nav>

  <h2 class="net-scene-title" tabindex="-1">{entryScene.title}</h2>
  <p class="net-intro">{entryScene.intro}</p>

  <div class="net-canvas" set:html={initialSvg} />

  <div class="net-sequence" hidden>
    <div class="net-sequence-controls">
      <button type="button" class="net-watch" aria-disabled="false"></button>
      <fieldset class="net-cache-toggle" hidden>
        <legend class="visually-hidden">Visit type</legend>
        <label><input type="radio" value="first" checked class="visually-hidden" /> First visit</label>
        <label><input type="radio" value="cached" class="visually-hidden" /> Cached</label>
      </fieldset>
    </div>
    <div class="net-spoof-trigger" hidden>
      <button type="button" class="net-spoof" aria-disabled="false"></button>
    </div>
    <ol class="net-steps" aria-live="polite"></ol>
  </div>

  <dl class="net-static-detail">
    {entryScene.nodes.map((n) => (
      <>
        <dt>{n.label}</dt>
        <dd>{n.caption}</dd>
      </>
    ))}
  </dl>

  <div class="net-detail">
    <p class="net-detail-hint">Select any node above to see what it does.</p>
  </div>
</section>

<script>
  import { mount } from '../../scripts/network/mount';
  document.querySelectorAll<HTMLElement>('.network-stage').forEach(mount);
</script>

<style>
  .network-stage {
    border: 1px solid var(--line);
    background: var(--bg-1);
    padding: var(--sp-5);
    margin: var(--sp-5) 0;
  }
  .net-scene-title { font-size: var(--step-1); color: var(--text-0); margin: 0 0 var(--sp-2); }
  .net-scene-title:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .net-intro { color: var(--text-1); max-width: 62ch; margin: 0 0 var(--sp-4); }

  .net-canvas { border: 1px solid var(--line); background: var(--bg-0); overflow-x: auto; }

  .net-static-detail {
    margin: var(--sp-4) 0 0;
    gap: var(--sp-1) var(--sp-4);
    grid-template-columns: max-content 1fr;
  }
  /* Own `display` only applies while NOT hidden — otherwise this rule's
     author-origin `display: grid` beats the UA stylesheet's
     `[hidden] { display: none }` regardless of specificity, since origin
     outranks specificity in the cascade, and the fallback list stays
     visible after mount.ts sets the hidden attribute. */
  .net-static-detail:not([hidden]) { display: grid; }
  .net-static-detail dt { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2); }
  .net-static-detail dd { margin: 0 0 var(--sp-3); color: var(--text-1); }

  .net-detail { border-top: 1px solid var(--line); padding-top: var(--sp-4); margin-top: var(--sp-4); min-height: 4rem; }
  .net-detail-hint { color: var(--text-2); font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.04em; margin: 0; }

  .net-sequence { margin: var(--sp-4) 0 0; }
  .net-sequence-controls { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
  .net-watch {
    background: var(--bg-2); border: 1px solid var(--accent); color: var(--accent);
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em;
    padding: var(--sp-2) var(--sp-4); cursor: pointer;
  }
  .net-watch:hover { background: var(--accent); color: var(--bg-0); }
  .net-watch:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .net-watch[aria-disabled='true'] { opacity: 0.5; cursor: default; }

  .net-cache-toggle { gap: var(--sp-1); margin: 0; padding: 0; border: none; }
  /* Same [hidden]-vs-own-display fix as .net-static-detail above: a
     fieldset defaults to display:block, and this needs display:flex only
     while visible. */
  .net-cache-toggle:not([hidden]) { display: flex; }
  .net-cache-toggle label {
    display: inline-flex; align-items: center; padding: var(--sp-1) var(--sp-3);
    border: 1px solid var(--line); color: var(--text-2);
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.04em;
    cursor: pointer;
  }
  .net-cache-toggle label:has(input:checked) { border-color: var(--accent); color: var(--accent); }
  .net-cache-toggle label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* A separate zone with its own top rule, not a third control folded
     into .net-sequence-controls — caching is a mode of the same normal
     flow, spoofing is a categorically different (attack) scenario, and
     the layout says so as plainly as the color does. No :not([hidden])
     guard needed here: a plain <div> stays at its default display:block,
     which never conflicts with [hidden]'s display:none — that fix is
     only required when an element's own rule sets a non-default display
     (grid/flex) at equal specificity, per .net-cache-toggle above. */
  .net-spoof-trigger { margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px solid var(--line); }
  .net-spoof {
    background: var(--bg-2); border: 1px solid var(--status-broken); color: var(--status-broken);
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em;
    padding: var(--sp-2) var(--sp-4); cursor: pointer;
  }
  .net-spoof:hover { background: var(--status-broken); color: var(--bg-0); }
  .net-spoof:focus-visible { outline: 2px solid var(--status-broken); outline-offset: 3px; }
  .net-spoof[aria-disabled='true'] { opacity: 0.5; cursor: default; }

  .net-steps { margin: var(--sp-4) 0 0; padding-left: 1.4em; display: flex; flex-direction: column; gap: var(--sp-2); }
</style>

<style is:global>
  /* Targets markup injected via set:html at build time and via
     mount.ts's innerHTML/createElement calls at runtime — neither path
     produces elements Astro's scoped-style compiler ever sees, so these
     rules are deliberately global rather than scoped. */
  .net-svg { display: block; width: 100%; height: auto; animation: net-fade-in 200ms ease-out; }
  @keyframes net-fade-in { from { opacity: 0; } to { opacity: 1; } }
  /* Below this width, scaling the SVG down by container width shrinks
     the node labels past legibility (11px in an 880-wide viewBox scales
     to under 4px on a 390px phone). Render at natural size and let
     .net-canvas scroll horizontally instead of shrinking to fit. */
  @media (max-width: 40rem) {
    .net-svg { width: 55rem; max-width: none; }
  }

  .net-edge { stroke: var(--line); stroke-width: 1; }

  .net-node .dot { fill: var(--topic-cyber); }
  .net-node--device .dot { fill: var(--accent); }
  .net-node--drill .dot { fill: var(--accent); }
  /* fill: transparent, not fill: none — SVG's `visiblePainted` pointer-
     events (the default) only counts an unstroked shape as hit-testable
     where it's actually painted. `none` paints nothing, so the halo's
     interior was a dead zone: the <g>'s own bounding box (circle + label
     below it) frequently centers in the gap between them, and automated
     clicks/some assistive tech that target an element's center point
     would land on nothing. `transparent` still paints (zero-alpha), so
     the full halo disc — not just the small inner dot — is clickable. */
  .net-node .halo { fill: transparent; stroke: var(--line-bright); stroke-opacity: 0; transition: stroke-opacity 150ms ease-out; }
  .net-node--drill .halo { stroke: var(--accent); stroke-opacity: 0.35; }
  .net-node:hover .halo,
  .net-node:focus-visible .halo { stroke-opacity: 0.55; }
  .net-node:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .net-label { font-family: var(--font-mono); font-size: 11px; fill: var(--text-1); }
  .net-node--drill .net-label { fill: var(--accent); }
  .net-node:hover .net-label,
  .net-node:focus-visible .net-label { fill: var(--text-0); }

  .net-breadcrumb ol {
    list-style: none; display: flex; flex-wrap: wrap; gap: var(--sp-2);
    margin: 0 0 var(--sp-4); padding: 0;
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em;
  }
  .net-breadcrumb li { display: flex; align-items: center; gap: var(--sp-2); color: var(--text-2); }
  .net-breadcrumb li:not(:last-child)::after { content: '▸'; margin-left: var(--sp-2); color: var(--line-bright); }
  .net-breadcrumb li[aria-current] { color: var(--text-0); }
  .net-breadcrumb button {
    background: none; border: none; padding: 0; font: inherit; letter-spacing: inherit;
    color: var(--text-1); text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
  }
  .net-breadcrumb button:hover,
  .net-breadcrumb button:focus-visible { color: var(--accent); }

  .net-detail-label {
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent); margin: 0 0 var(--sp-2);
  }
  .net-detail p { color: var(--text-1); margin: 0 0 var(--sp-2); max-width: 62ch; }
  .net-continue {
    margin-top: var(--sp-2); background: var(--bg-2); border: 1px solid var(--accent); color: var(--accent);
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em;
    padding: var(--sp-2) var(--sp-3); cursor: pointer;
  }
  .net-continue:hover { background: var(--accent); color: var(--bg-0); }

  /* Packet playback (Phase B) — packets.ts creates/positions this circle
     and toggles these classes; transition timing is set inline by
     packets.ts itself (STEP_MOVE_MS), not here, so there is one place
     that number lives. */
  .net-packet { fill: var(--accent); }
  .net-edge.is-active { stroke: var(--accent); stroke-width: 2; }
  .net-node--active .dot { fill: var(--accent); }
  .net-node--active .halo { stroke: var(--accent); stroke-opacity: 0.6; }
  @keyframes net-pulse { 0%, 100% { stroke-opacity: 0.35; } 50% { stroke-opacity: 0.9; } }
  .net-node--pulse .halo { stroke: var(--accent); animation: net-pulse 500ms ease-in-out; }

  .net-steps li { color: var(--text-1); max-width: 62ch; }
  .net-steps li[aria-current] { color: var(--text-0); font-weight: 600; }

  /* Attacker node (Phase C) — reuses the site's existing danger token
     rather than inventing a new color; --status-broken is already used
     consistently for "something is wrong" across the Tools section. */
  .net-node--attacker .dot { fill: var(--status-broken); }
  .net-node--attacker .halo { stroke: var(--status-broken); }
  .net-node--attacker .net-label { fill: var(--status-broken); }
  /* Compound selector, not source order: .net-node--active/--pulse are
     equal specificity to .net-node--attacker's own rules above, so
     without this the attacker node would flash the generic in-transit
     blue mid-animation — exactly when staying visually "attacker" matters
     most. Three classes beats two regardless of order. */
  .net-node--attacker.net-node--active .dot { fill: var(--status-broken); }
  .net-node--attacker.net-node--active .halo { stroke: var(--status-broken); }
  .net-node--attacker.net-node--pulse .halo { stroke: var(--status-broken); }

  /* Persists after a spoof sequence completes (cleared by mount.ts's
     stopPlayback on the next interaction) — a lingering "this is
     compromised now" mark, distinct from the transient in-flight
     --active/--pulse states above. */
  .net-node--compromised .halo { stroke: var(--status-broken); stroke-opacity: 0.6; }

  /* Subnet slider — injected into .net-detail by subnet-tool.ts when the
     L2 "Subnetting" node is selected. Global for the same reason
     .net-continue/.net-detail-label are: created via document.createElement,
     never present in the build-time template Astro's scoped-style
     compiler processes. */
  .subnet-tool { margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px solid var(--line); }
  .subnet-tool-field { display: flex; align-items: center; gap: var(--sp-3); margin: 0 0 var(--sp-4); }
  .subnet-tool-field span {
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .subnet-tool-field input[type='range'] { flex: 1; accent-color: var(--accent); }
  .subnet-tool-field output { font-family: var(--font-mono); color: var(--accent); min-width: 3ch; }

  .subnet-bits { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin: 0 0 var(--sp-4); }
  .subnet-octet { display: flex; gap: 2px; }
  .subnet-bit { width: 10px; height: 20px; background: var(--line); }
  .subnet-bit.is-network { background: var(--accent); }
  .subnet-bit.is-host { background: var(--topic-cyber); }

  .subnet-stats {
    display: grid; grid-template-columns: max-content 1fr; gap: var(--sp-1) var(--sp-4);
    font-size: var(--step--1); margin: 0 0 var(--sp-3);
  }
  .subnet-stats dt { font-family: var(--font-mono); color: var(--text-2); text-transform: uppercase; letter-spacing: 0.08em; }
  .subnet-stats dd { margin: 0; color: var(--text-0); font-family: var(--font-mono); }

  .subnet-link { margin: 0; font-size: var(--step--1); }
  .subnet-link a { color: var(--accent); }
</style>
