---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SavageNav from '../../../components/savage/SavageNav.astro';
import { getCollection } from 'astro:content';
import '../../../styles/savage.css';

export async function getStaticPaths() {
  const domains = await getCollection('savageDomains');
  return domains.map((d) => ({ params: { domain: d.id }, props: { domain: d } }));
}
const { domain } = Astro.props;
const standards = (await getCollection('savageStandards', ({ data }) => !data.draft && data.domain.id === domain.id))
  .sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
const slug = (id: string) => id.split('/').pop();
---
<BaseLayout title={`${domain.data.label} — The Savage Bible`} description={domain.data.blurb} noindex bodyClass="savage">
  <SavageNav trail={[{ label: domain.data.label }]} />
  <header class="sv-head">
    <p class="sv-eyebrow">{domain.data.code} · Domain {pad(domain.data.order)}</p>
    <h1>{domain.data.label}</h1>
    <p class="sv-creed">{domain.data.creed}</p>
    <p class="sv-lede">{domain.data.blurb}</p>
  </header>

  {standards.length === 0 && <p class="sv-lede">No standards written yet.</p>}
  <ol class="sv-list">
    {standards.map((s) => (
      <li>
        <a href={`/savage/${domain.id}/${slug(s.id)}/`}>
          <span class="sv-cite">{domain.data.code}·{pad(s.data.order)}</span>
          <span class="t">{s.data.title}</span>
          <p class="c">{s.data.ceiling}</p>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
