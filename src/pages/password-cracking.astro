---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Tldr, Eli5, WhyItMatters, HowItWorks, FailureModes, WhatILearned } from '../components/blocks';
---
<BaseLayout
  title="Password Cracking"
  description="Why some passwords fall in under a second and others hold for centuries — and why the site you signed up on matters more than your password."
>
  <p class="eyebrow"><a href="/">← Topics</a></p>
  <h1>Password Cracking</h1>

  <Tldr>
    A password's strength is only half the story. The other half is how the
    site stored it. A "strong" password hashed badly can fall in seconds; a
    plain English phrase hashed well can hold for centuries.
  </Tldr>

  <Eli5>
    Imagine two locks. One lets you try a new combination every millisecond,
    forever. The other makes you wait a full second between every guess. The
    second lock is <em>less</em> convenient for everyone — including you —
    but it's the reason a break-in takes years instead of minutes.
  </Eli5>

  <WhyItMatters>
    When a company gets breached, attackers don't get your plaintext
    password — they get a database of <em>hashes</em>. Cracking is the
    process of guessing passwords, hashing each guess, and checking for a
    match. How fast that's possible depends almost entirely on which hash
    function the company used, not on how clever your password felt when
    you picked it.
  </WhyItMatters>

  <HowItWorks>
    <p>
      Two things decide how long cracking takes: how many guesses exist
      (your password's <strong>entropy</strong>) and how many guesses per
      second the attacker can try (the <strong>hash speed</strong>).
    </p>
    <p>
      A fast, unsalted hash like plain MD5 can be tried at roughly 100
      billion guesses per second on a single modern GPU. A hash function
      built for passwords — bcrypt, scrypt, Argon2 — deliberately costs
      real CPU/memory per guess, dropping that to maybe 10,000 guesses per
      second or fewer. That's a seven order-of-magnitude difference, from
      the exact same leaked database.
    </p>
  </HowItWorks>

  <section class="lab" aria-labelledby="lab-heading">
    <h2 id="lab-heading" class="eyebrow section-heading">Try it yourself</h2>
    <p class="lab-note">
      Everything here runs in your browser. Nothing you type is sent
      anywhere, logged, or stored.
    </p>
    <label for="pw-input" class="pw-label">Type a password:</label>
    <input id="pw-input" type="text" autocomplete="off" spellcheck="false" placeholder="try something" />
    <div class="pw-results" id="pw-results" aria-live="polite">
      <div class="pw-row">
        <span class="pw-key">Entropy</span>
        <span class="pw-val" id="pw-entropy">—</span>
      </div>
      <div class="pw-row">
        <span class="pw-key">Fast hash (MD5-class, ~10<sup>11</sup>/s)</span>
        <span class="pw-val" id="pw-fast">—</span>
      </div>
      <div class="pw-row">
        <span class="pw-key">Slow hash (bcrypt-class, ~10<sup>4</sup>/s)</span>
        <span class="pw-val" id="pw-slow">—</span>
      </div>
    </div>
  </section>

  <FailureModes>
    <ul>
      <li><strong>"P@ssw0rd1!" isn't strong.</strong> Swapping letters for symbols is the first thing cracking dictionaries try — it barely raises entropy over the base word.</li>
      <li><strong>Reused passwords are cracked once, used everywhere.</strong> An attacker doesn't need to crack your bank password if they cracked the same one from a forum breach three years ago.</li>
      <li><strong>Length beats complexity.</strong> A four-random-word passphrase usually has more entropy than an 8-character soup of symbols, and is easier to actually remember.</li>
    </ul>
  </FailureModes>

  <WhatILearned>
    You can't control how a site hashes your password — but you can control
    two things that matter regardless: use a long, unique passphrase per
    site, and let a password manager generate and remember the rest. That
    combination is what actually survives a breach.
  </WhatILearned>
</BaseLayout>

<script>
  const input = document.getElementById('pw-input') as HTMLInputElement;
  const entropyEl = document.getElementById('pw-entropy')!;
  const fastEl = document.getElementById('pw-fast')!;
  const slowEl = document.getElementById('pw-slow')!;

  const FAST_GUESSES_PER_SEC = 1e11;
  const SLOW_GUESSES_PER_SEC = 1e4;

  function charsetSize(pw: string): number {
    let size = 0;
    if (/[a-z]/.test(pw)) size += 26;
    if (/[A-Z]/.test(pw)) size += 26;
    if (/[0-9]/.test(pw)) size += 10;
    if (/[^a-zA-Z0-9]/.test(pw)) size += 33;
    return size || 1;
  }

  function formatDuration(seconds: number): string {
    if (!isFinite(seconds) || seconds < 0) return '—';
    if (seconds < 1) return 'instant';
    const units: [string, number][] = [
      ['second', 1], ['minute', 60], ['hour', 3600], ['day', 86400],
      ['year', 31557600], ['century', 3155760000], ['millennium', 31557600000],
    ];
    let chosen = units[0];
    for (const u of units) if (seconds >= u[1]) chosen = u;
    const value = seconds / chosen[1];
    if (chosen[0] === 'millennium' && value > 1e6) return `${value.toExponential(1)} millennia`;
    return `${value < 10 ? value.toFixed(1) : Math.round(value).toLocaleString()} ${chosen[0]}${value >= 2 ? 's' : ''}`;
  }

  function update() {
    const pw = input.value;
    if (!pw) {
      entropyEl.textContent = '—';
      fastEl.textContent = '—';
      slowEl.textContent = '—';
      return;
    }
    const bits = pw.length * Math.log2(charsetSize(pw));
    const combinations = Math.pow(2, bits);
    // Average crack time assumes the guess is found halfway through the
    // keyspace, which is the standard convention for this estimate.
    const avgGuesses = combinations / 2;
    entropyEl.textContent = `${bits.toFixed(1)} bits`;
    fastEl.textContent = formatDuration(avgGuesses / FAST_GUESSES_PER_SEC);
    slowEl.textContent = formatDuration(avgGuesses / SLOW_GUESSES_PER_SEC);
  }

  input.addEventListener('input', update);
</script>

<style>
  .lab { margin: var(--sp-6) 0; padding: var(--sp-4); border: 1px solid var(--line); background: var(--bg-1); }
  .section-heading { margin-bottom: var(--sp-2); }
  .lab-note { color: var(--text-2); font-size: var(--step--1); margin-bottom: var(--sp-4); }
  .pw-label { display: block; font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em; color: var(--text-1); margin-bottom: var(--sp-2); }
  #pw-input {
    width: 100%; font-family: var(--font-mono); font-size: var(--step-1); padding: var(--sp-3);
    background: var(--bg-0); border: 1px solid var(--line-bright); color: var(--text-0);
  }
  #pw-input:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pw-results { margin-top: var(--sp-4); display: grid; gap: var(--sp-2); }
  .pw-row { display: flex; justify-content: space-between; gap: var(--sp-3); font-family: var(--font-mono); font-size: var(--step--1); padding: var(--sp-2) 0; border-bottom: 1px solid var(--line); }
  .pw-key { color: var(--text-1); }
  .pw-val { color: var(--text-0); font-weight: 700; }
</style>
