---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format';

const [resources, topics] = await Promise.all([getCollection('resources'), getCollection('topics')]);
const topicById = Object.fromEntries(topics.map((t) => [t.id, t.data]));
const byDate = [...resources].sort((a, b) => b.data.added.getTime() - a.data.added.getTime());
const filters = [...topics].sort((a, b) => a.data.order - b.data.order).map((t) => ({ id: t.data.id, label: t.data.label }));
const filterCss = filters
  .map((f) => `.res-root:has(#filter-${f.id}:checked) .res-list > li:not([data-filters~="${f.id}"]){display:none}`)
  .join('\n');
---
<BaseLayout title="Resources" description="A curated reference library — the tools, repos and reading I actually reach for.">
  <header class="page-head">
    <p class="eyebrow">Resources</p>
    <h1>Reference library</h1>
    <p class="lede">
      {resources.length} entries. Everything here earns its place by being used,
      not by being impressive.
    </p>
  </header>

  <div class="res-root">
    <details class="filter-disclosure">
      <summary>Browse by topic</summary>
      <fieldset class="filters">
        <legend class="visually-hidden">Filter resources by topic</legend>
        <input type="radio" name="res-filter" id="filter-all" checked class="visually-hidden" />
        <label for="filter-all">ALL</label>
        {filters.map((f) => (
          <>
            <input type="radio" name="res-filter" id={`filter-${f.id}`} class="visually-hidden" />
            <label for={`filter-${f.id}`}>{f.label}</label>
          </>
        ))}
      </fieldset>
    </details>

    <ul class="res-list">
      {byDate.map((r) => (
        <li id={r.id} data-filters={r.data.topics.map((t: any) => t.id).join(' ')}>
          <a href={r.data.url} rel="noopener noreferrer" target="_blank">
            <span class="head"><span class="t">{r.data.title}</span><span class="kind">{r.data.kind}</span></span>
            <span class="why">{r.data.why}</span>
            <span class="foot">
              {r.data.topics.map((t: any) => (
                <span class="topic" style={`--t: var(${topicById[t.id]?.accent})`}>{topicById[t.id]?.label}</span>
              ))}
              <time datetime={r.data.added.toISOString()}>{formatDate(r.data.added)}</time>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style set:html={filterCss}></style>
<style>
  .page-head { padding: var(--sp-6) 0 var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); }
  h1 { font-size: var(--step-3); margin: var(--sp-3) 0; }
  .lede { color: var(--text-1); max-width: 62ch; }
  .filter-disclosure { margin-bottom: var(--sp-5); }
  .filter-disclosure summary {
    cursor: pointer; font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.1em; color: var(--text-1); text-transform: uppercase;
    padding: var(--sp-2) 0; list-style: none;
  }
  .filter-disclosure summary::-webkit-details-marker { display: none; }
  .filter-disclosure summary::before { content: '▸ '; }
  .filter-disclosure[open] summary::before { content: '▾ '; }
  .filter-disclosure[open] summary { color: var(--accent); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--sp-2); border: 0; padding: var(--sp-3) 0 0; margin: 0; }
  .filters label { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--text-1); border: 1px solid var(--line); padding: var(--sp-2) var(--sp-3); cursor: pointer; }
  .filters input:checked + label { color: var(--bg-0); background: var(--accent); border-color: var(--accent); font-weight: 700; }
  .filters input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
  .res-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: var(--sp-4); }
  .res-list a { display: grid; gap: var(--sp-2); padding: var(--sp-4); border: 1px solid var(--line); background: var(--bg-1); text-decoration: none; height: 100%; }
  .res-list a:hover { border-color: var(--accent); background: var(--bg-2); }
  .head { display: flex; justify-content: space-between; gap: var(--sp-3); align-items: baseline; }
  .t { color: var(--text-0); font-weight: 700; font-size: var(--step-1); }
  .kind { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2); letter-spacing: 0.1em; }
  .why { color: var(--text-1); }
  .foot { display: flex; gap: var(--sp-3); flex-wrap: wrap; align-items: center; margin-top: auto; font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); }
  .topic { color: var(--t); }
</style>
