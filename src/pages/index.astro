---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DOMAINS } from '../lib/domains';
---
<BaseLayout
  title="Home"
  description="Complex technical topics, explained plainly. ELI5 and TL;DR first, hands-on labs where it helps."
>
  <header class="hero">
    <p class="eyebrow">Explained plainly</p>
    <h1>Complex topics, explained plainly.</h1>
    <p class="hero-lede">
      TL;DR and ELI5 come first on every topic — go deeper only if you want
      to. Every domain below follows the same idea: understand it by
      trying it, not just reading about it.
    </p>
  </header>

  <section aria-labelledby="domains-heading">
    <h2 id="domains-heading" class="eyebrow section-heading">Domains</h2>
    <ul class="domain-list">
      {DOMAINS.map((d) => (
        <li>
          <a href={`/${d.slug}/`}>
            <span class="domain-top">
              <span class="domain-title">{d.name}</span>
              <span class="domain-count">{d.topics.length} topic{d.topics.length === 1 ? '' : 's'}</span>
            </span>
            <span class="domain-blurb">{d.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero { padding-bottom: var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-6); }
  .hero h1 { font-size: var(--step-4); margin: var(--sp-3) 0 var(--sp-4); max-width: 20ch; }
  .hero-lede { color: var(--text-1); font-size: var(--step-1); }
  .section-heading { margin-bottom: var(--sp-4); }

  .domain-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
  .domain-list a {
    display: grid; gap: var(--sp-2); padding: var(--sp-4);
    border: 1px solid var(--line); background: var(--bg-1); text-decoration: none;
    transition: border-color 150ms ease-out, background 150ms ease-out;
  }
  .domain-list a:hover { border-color: var(--accent); background: var(--bg-2); }
  .domain-top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-3); }
  .domain-title { color: var(--text-0); font-weight: 700; font-size: var(--step-1); }
  .domain-count { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .domain-blurb { color: var(--text-1); }
</style>
