---
import BaseLayout from '../layouts/BaseLayout.astro';

// Flat list for now — a real index/collection can replace this once
// there's enough here to need filtering.
const topics = [
  { href: '/password-cracking/', title: 'Password Cracking', blurb: 'Why "P@ssw0rd!" falls in under a second, and what actually holds up.' },
  { href: '/phishing/', title: 'Phishing', blurb: 'Read a URL like an attacker built it — try the inspector yourself.' },
];
---
<BaseLayout
  title="Home"
  description="Cybersecurity, explained plainly. ELI5 and TL;DR first, hands-on labs where it helps, inspired by Go Hack Yourself."
>
  <header class="hero">
    <p class="eyebrow">Security, ELI5</p>
    <h1>Complex security topics, explained plainly.</h1>
    <p class="hero-lede">
      TL;DR and ELI5 come first on every topic — go deeper only if you want to.
      Inspired by <em>Go Hack Yourself</em> by Bryson Payne: understand it by trying it.
    </p>
  </header>

  <section aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="eyebrow section-heading">Topics</h2>
    <ul class="topic-list">
      {topics.map((t) => (
        <li>
          <a href={t.href}>
            <span class="topic-title">{t.title}</span>
            <span class="topic-blurb">{t.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero { padding-bottom: var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-6); }
  .hero h1 { font-size: var(--step-4); margin: var(--sp-3) 0 var(--sp-4); max-width: 20ch; }
  .hero-lede { color: var(--text-1); font-size: var(--step-1); }
  .section-heading { margin-bottom: var(--sp-4); }

  .topic-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
  .topic-list a {
    display: grid; gap: var(--sp-1); padding: var(--sp-4);
    border: 1px solid var(--line); background: var(--bg-1); text-decoration: none;
    transition: border-color 150ms ease-out, background 150ms ease-out;
  }
  .topic-list a:hover { border-color: var(--accent); background: var(--bg-2); }
  .topic-title { color: var(--text-0); font-weight: 700; }
  .topic-blurb { color: var(--text-1); }
</style>
