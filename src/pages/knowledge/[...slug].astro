---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntries, render } from 'astro:content';

export async function getStaticPaths() {
  const knowledge = await getCollection('knowledge', ({ data }) => !data.draft);
  return knowledge.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const topics = await getEntries(entry.data.topics);
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article" publishedTime={entry.data.date}>
  <header class="page-head">
    <p class="eyebrow">Knowledge</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
  </header>

  <div class="prose"><Content /></div>

  <p class="topics">
    {topics.map((t: any) => <a href={`/topics/${t.data.id}/`} style={`--t: var(${t.data.accent})`}>{t.data.label}</a>)}
  </p>
</BaseLayout>
<style>
  .page-head { padding: var(--sp-6) 0 var(--sp-5); margin-bottom: var(--sp-5); }
  h1 { font-size: var(--step-3); margin: var(--sp-3) 0; }
  .lede { color: var(--text-1); font-size: var(--step-1); max-width: 62ch; }
  /* No max-width on .prose itself — the embedded NetworkStage needs the
     full .wrap width to keep node labels legible. Only text elements
     get a reading-width cap; :global() is required because content
     rendered via <Content /> isn't part of this component's scoped
     template and Astro's scoped styles never reach it otherwise. */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    max-width: 68ch;
    color: var(--text-1);
  }
  .topics { display: flex; gap: var(--sp-3); margin-top: var(--sp-6); }
  .topics a { color: var(--t); font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.08em; text-decoration: none; border: 1px solid var(--line); padding: var(--sp-2) var(--sp-3); }
</style>
