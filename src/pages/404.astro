---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found" description="That route does not exist.">
  <div class="nf">
    <p class="code">404</p>
    <h1>No route by that name</h1>
    <p class="lede">The page you asked for is not here. It may have moved, or it may never have existed.</p>
    <p><a href="/">Back to the feed</a> · <button type="button" data-open-palette class="link">Search the site</button></p>
  </div>
</BaseLayout>
<style>
  .nf { padding: var(--sp-7) 0; max-width: 60ch; }
  .code { font-family: var(--font-display); font-size: var(--step-4); color: var(--accent); margin: 0; }
  h1 { font-size: var(--step-2); margin: var(--sp-3) 0; }
  .lede { color: var(--text-1); }
  .link { background: none; border: 0; color: var(--accent); font: inherit; cursor: pointer; text-decoration: underline; padding: 0; }
</style>
