---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusLight from '../../components/ui/StatusLight.astro';
import { getCollection, getEntries, render } from 'astro:content';
import { postsForProject } from '../../lib/graph';
import { formatDate } from '../../lib/format';
import { cardSpec } from '../../lib/card-spec';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const topics = await getEntries(project.data.topics);
// The reverse edge — computed, never authored on both sides.
const posts = await postsForProject(project.id);
---
<BaseLayout title={project.data.title} description={project.data.description} type="article" publishedTime={project.data.date}>
  <header class="page-head">
    <p class="eyebrow">Project</p>
    <div class="titlerow">
      <h1>{project.data.title}</h1>
      <StatusLight status={project.data.status} />
    </div>
    <p class="lede">{project.data.description}</p>
    <dl class="spec">
      <dt>Shipped</dt><dd><time datetime={project.data.date.toISOString()}>{formatDate(project.data.date)}</time></dd>
      <dt>Stack</dt><dd>{project.data.tools.join(' · ')}</dd>
      {project.data.repo && <><dt>Source</dt><dd><a href={project.data.repo} rel="noopener noreferrer" target="_blank">{project.data.repo}</a></dd></>}
      {project.data.built && <><dt>Built</dt><dd>{project.data.built}</dd></>}
      {project.data.model && <><dt>Model</dt><dd>{project.data.model}</dd></>}
    </dl>
    <p class="topics">
      {topics.map((t: any) => <a href={`/topics/${t.data.id}/`} style={`--t: var(${t.data.accent})`}>{t.data.label}</a>)}
    </p>
  </header>

  <div class="prose"><Content /></div>

  {posts.length > 0 && (
    <aside class="related">
      <h2 class="eyebrow">Posts about this project</h2>
      <ul>
        {posts.map((p) => (
          <li style={`--a: var(${cardSpec(p.data.type).accent})`}>
            <a href={`/posts/${p.id}/`}><span class="kind">{p.data.type}</span>{p.data.title}</a>
          </li>
        ))}
      </ul>
    </aside>
  )}
</BaseLayout>
<style>
  .page-head { padding: var(--sp-6) 0 var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); }
  .titlerow { display: flex; gap: var(--sp-4); align-items: center; flex-wrap: wrap; }
  h1 { font-size: var(--step-3); margin: var(--sp-3) 0; }
  .lede { color: var(--text-1); font-size: var(--step-1); max-width: 62ch; }
  .spec { display: grid; grid-template-columns: max-content 1fr; gap: var(--sp-2) var(--sp-5); margin: var(--sp-4) 0; font-size: var(--step--1); }
  .spec dt { font-family: var(--font-mono); color: var(--text-2); text-transform: uppercase; letter-spacing: 0.1em; }
  .spec dd { margin: 0; color: var(--text-1); }
  .topics { display: flex; gap: var(--sp-3); }
  .topics a { color: var(--t); font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.08em; text-decoration: none; border: 1px solid var(--line); padding: var(--sp-2) var(--sp-3); }
  .prose { max-width: 72ch; }
  .prose :global(h2) { font-size: var(--step-1); margin-top: var(--sp-5); }
  .related { border-top: 1px solid var(--line); padding-top: var(--sp-5); margin-top: var(--sp-6); }
  .related ul { list-style: none; padding: 0; margin: var(--sp-3) 0 0; display: grid; gap: var(--sp-2); }
  .related a { display: flex; gap: var(--sp-3); color: var(--text-0); text-decoration: none; }
  .related a:hover { color: var(--a); }
  .kind { font-family: var(--font-mono); font-size: var(--step--1); color: var(--a); letter-spacing: 0.1em; min-width: 11ch; }
  @media (max-width: 40rem) { .spec { grid-template-columns: 1fr; gap: var(--sp-1); } .spec dd { margin-bottom: var(--sp-2); } }
</style>
