---
// One dynamic route for every domain that just lists its topics
// plainly. AI is excluded on purpose -- it has its own hand-built gear
// command center at src/pages/ai/index.astro instead of this template.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DOMAINS, type Domain } from '../../lib/domains';

export function getStaticPaths() {
  return DOMAINS.filter((d) => d.slug !== 'ai').map((d) => ({
    params: { domain: d.slug },
    props: { domain: d },
  }));
}

interface Props { domain: Domain }
const { domain } = Astro.props;
---
<BaseLayout title={domain.name} description={domain.blurb}>
  <p class="eyebrow"><a href="/">← Domains</a></p>
  <h1>{domain.name}</h1>
  <p class="domain-lede">{domain.blurb}</p>

  <ul class="topic-list">
    {domain.topics.map((t) => (
      <li>
        <a href={t.href}>
          <span class="topic-title">{t.title}{t.isNew && <span class="new-badge">NEW</span>}</span>
          <span class="topic-blurb">{t.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .domain-lede { color: var(--text-1); font-size: var(--step-1); margin: var(--sp-3) 0 var(--sp-6); max-width: 58ch; }

  .topic-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
  .topic-list a {
    display: grid; gap: var(--sp-1); padding: var(--sp-4);
    border: 1px solid var(--line); background: var(--bg-1); text-decoration: none;
    transition: border-color 150ms ease-out, background 150ms ease-out;
  }
  .topic-list a:hover { border-color: var(--accent); background: var(--bg-2); }
  .topic-title { color: var(--text-0); font-weight: 700; }
  .topic-blurb { color: var(--text-1); }
  .new-badge {
    display: inline-block; margin-left: var(--sp-2); padding: 0.1em 0.5em; vertical-align: middle;
    background: var(--status-working); color: var(--bg-0); font-family: var(--font-mono);
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em;
  }
</style>
