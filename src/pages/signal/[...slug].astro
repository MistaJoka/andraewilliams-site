---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceCredit from '../../components/signal/SourceCredit.astro';
import { TRACK_META, SIGNAL_ACCENT } from '../../lib/signal';
import { formatDate, readingTime } from '../../lib/format';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('signal', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const track = TRACK_META[entry.data.track];

// Topics are optional here, so resolve only what is actually set.
const topics = (
  await Promise.all(entry.data.topics.map((ref: any) => getEntry(ref)))
).filter(Boolean);
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  ogImage={`/og/signal/${entry.id}.png`}
  publishedTime={entry.data.date}
>
  <article class="signal" style={`--card-accent: var(${SIGNAL_ACCENT})`}>
    <header class="head">
      <p class="row">
        <a class="track" href="/signal/">
          <span class="glyph" aria-hidden="true">{track.glyph}</span>SIGNAL · {track.label}
        </a>
      </p>

      <h1>{entry.data.title}</h1>

      <p class="lede">{entry.data.description}</p>

      <div class="row meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        {entry.data.updated && <span>UPDATED {formatDate(entry.data.updated)}</span>}
        <span>{readingTime(entry.body)} MIN</span>
        <span class="topics">
          {topics.map((t: any) => (
            <a href={`/topics/${t.data.id}/`} style={`--t: var(${t.data.accent})`}>{t.data.label}</a>
          ))}
        </span>
      </div>
    </header>

    <SourceCredit source={entry.data.source} built={entry.data.built} model={entry.data.model} />

    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .signal { padding-bottom: var(--sp-6); }
  .head { padding: var(--sp-6) 0 var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); }
  .row { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-4); align-items: center; margin: 0; }
  h1 { font-size: var(--step-4); margin: var(--sp-4) 0; max-width: 22ch; }
  .lede { color: var(--text-1); font-size: var(--step-1); max-width: 62ch; }
  .track {
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.1em; color: var(--card-accent); text-decoration: none;
    display: inline-flex; gap: var(--sp-2); align-items: baseline;
  }
  .track:hover { text-decoration: underline; text-underline-offset: 3px; }
  .meta {
    margin-top: var(--sp-4);
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.08em; color: var(--text-2); text-transform: uppercase;
  }
  .topics { display: inline-flex; gap: var(--sp-3); }
  .topics a { color: var(--t); text-decoration: none; border-bottom: 1px solid transparent; }
  .topics a:hover { border-bottom-color: var(--t); }

  .prose { max-width: 72ch; }
  .prose :global(h2) {
    font-size: var(--step-2); margin-top: var(--sp-6);
    padding-top: var(--sp-3); border-top: 1px solid var(--line);
  }
  .prose :global(h3) { font-size: var(--step-1); margin-top: var(--sp-5); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; margin-bottom: var(--sp-4); }
  .prose :global(li) { margin-bottom: var(--sp-2); }
  .prose :global(strong) { color: var(--text-0); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--line); padding: var(--sp-2) var(--sp-3); text-align: left;
  }
  .prose :global(pre) { background: var(--bg-1) !important; }
  @media (max-width: 40rem) { h1 { font-size: var(--step-3); } }
</style>
