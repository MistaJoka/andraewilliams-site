---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignalGrid from '../../components/signal/SignalGrid.astro';
import { TRACK_META } from '../../lib/signal';
import { TRACKS } from '../../lib/enums';
import { getCollection } from 'astro:content';
import '../../styles/cards.css';

const entries = await getCollection('signal', ({ data }) => !data.draft);
const byDate = [...entries].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Only offer a track filter that actually has something behind it.
const present = new Set(byDate.map((e) => e.data.track));
const filters = TRACKS.filter((t) => present.has(t)).map((t) => ({ id: t, label: TRACK_META[t].label }));

const DESCRIPTION =
  'Articles and talks worth keeping, compressed to the load-bearing idea — with the original always one click away.';
---
<BaseLayout title="Signal" description={DESCRIPTION}>
  <header class="page-head">
    <p class="eyebrow">Signal</p>
    <h1>Signal</h1>
    <p class="lede">{DESCRIPTION}</p>
    <p class="disclosure">
      Each entry is an AI-written compression of somebody else's work, published
      here so it stays findable. Every one credits and links its source. These are
      not <a href="/feed/">Andrae's own notes</a>.
    </p>
  </header>

  {byDate.length === 0
    ? <p class="none">Nothing published yet.</p>
    : <SignalGrid entries={byDate} filters={filters} />}
</BaseLayout>

<style>
  .page-head { padding: var(--sp-6) 0 var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); }
  h1 { font-size: var(--step-3); margin: var(--sp-3) 0; }
  .lede { color: var(--text-1); max-width: 62ch; }
  .disclosure {
    margin-top: var(--sp-4); max-width: 62ch;
    font-family: var(--font-mono); font-size: var(--step--1);
    line-height: 1.6; color: var(--text-2);
  }
  .disclosure a { color: var(--text-1); }
  .none { color: var(--text-2); font-family: var(--font-mono); font-size: var(--step--1); }
</style>
