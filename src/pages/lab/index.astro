---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusLight from '../../components/ui/StatusLight.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';

const lab = await getCollection('lab', ({ data }) => !data.draft);
const byDate = [...lab].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="Lab" description="Active experiments — shaders, simulations, local models and things that may not work yet.">
  <header class="page-head">
    <p class="eyebrow">Lab</p>
    <h1>Active experiments</h1>
    <p class="lede">
      {lab.length} entries. Each one runs in your browser when you ask it to —
      nothing starts on its own.
    </p>
  </header>
  <ul class="list">
    {byDate.map((l) => (
      <li>
        <a href={`/lab/${l.id}/`}>
          <span class="top"><span class="t">{l.data.title}</span><StatusLight status={l.data.status} /></span>
          <span class="d">{l.data.description}</span>
          <span class="foot">
            <time datetime={l.data.date.toISOString()}>{formatDate(l.data.date)}</time>
            <span>{l.data.tools.join(' · ')}</span>
            <span class="outcome">{l.data.outcome}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
<style>
  .page-head { padding: var(--sp-6) 0 var(--sp-5); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); }
  h1 { font-size: var(--step-3); margin: var(--sp-3) 0; }
  .lede { color: var(--text-1); max-width: 62ch; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: var(--sp-4); }
  .list a { display: grid; gap: var(--sp-3); padding: var(--sp-4); border: 1px solid var(--line); background: var(--bg-1); text-decoration: none; height: 100%; }
  .list a:hover { border-color: var(--accent); background: var(--bg-2); }
  .top { display: flex; justify-content: space-between; gap: var(--sp-3); align-items: center; flex-wrap: wrap; }
  .t { color: var(--text-0); font-size: var(--step-1); font-weight: 700; }
  .d { color: var(--text-1); }
  .foot { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: auto; font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-2); letter-spacing: 0.08em; text-transform: uppercase; }
  .outcome { color: var(--status-working); }
</style>
