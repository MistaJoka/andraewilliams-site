---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sources from '../components/Sources.astro';
import RelatedTopics from '../components/RelatedTopics.astro';
import VerifiedDate from '../components/VerifiedDate.astro';
import { STACK_COMBOS } from '../lib/stack-combos';
---
<BaseLayout
  title="Tech Stack Fundamentals"
  description="The tech stack knowledge every full-stack and AI-app developer needs. Walk the pipeline top to bottom — browser, server, database — then watch a real request move through all three, live."
>
  <p class="eyebrow"><a href="/systems/">← Systems</a></p>
  <h1>Tech Stack Fundamentals</h1>
  <VerifiedDate />

  <div class="infographic">

    <section class="ig-hero">
      <p class="ig-kicker">The big picture — click a layer to jump to it</p>
      <nav class="pipeline pipeline-nav" aria-label="Jump to a layer">
        <a class="pipe-node" href="#browser">
          <span class="pipe-icon" aria-hidden="true">▣</span>
          <span class="pipe-name">Browser</span>
          <span class="pipe-note">Ask</span>
        </a>
        <div class="pipe-edge"><span class="pipe-edge-note">HTTP</span></div>
        <a class="pipe-node" href="#server">
          <span class="pipe-icon" aria-hidden="true">▤</span>
          <span class="pipe-name">Server</span>
          <span class="pipe-note">Decide</span>
        </a>
        <div class="pipe-edge"><span class="pipe-edge-note">SQL</span></div>
        <a class="pipe-node" href="#database">
          <span class="pipe-icon" aria-hidden="true">▦</span>
          <span class="pipe-name">Database</span>
          <span class="pipe-note">Store</span>
        </a>
      </nav>
      <ul class="ig-tldr">
        <li>Three unchanging jobs, one per layer above — <strong>ask</strong>, <strong>decide</strong>, <strong>store</strong>.</li>
        <li>Formally a <strong>three-tier architecture</strong>: each tier independently replaceable, talking only over defined protocols.</li>
        <li>Most real bugs live at the <strong>seams</strong> between tiers, not inside one — the live run further down makes that visible.</li>
      </ul>
    </section>

    <section class="ig-step" id="browser" style={{ '--step-accent': 'var(--accent)' }}>
      <div class="ig-step-head">
        <span class="ig-step-icon" aria-hidden="true">▣</span>
        <div>
          <p class="ig-step-kicker">01 · ASK</p>
          <h2>Browser</h2>
        </div>
      </div>
      <p class="ig-eli5">Like telling a waiter what you want: sends the request, then renders whatever comes back.</p>
      <div class="ig-step-grid">
        <div class="ig-step-block">
          <p class="ig-step-label">Real-world tools</p>
          <p>React, Vue, Svelte — runs entirely in the visitor's browser.</p>
        </div>
        <div class="ig-step-block">
          <p class="ig-step-label">When to use what</p>
          <p>Validate input here for instant feedback — but never <em>only</em> here. A browser can always be bypassed; nothing it says is trustworthy on its own.</p>
        </div>
      </div>
    </section>

    <section class="ig-step" id="server" style={{ '--step-accent': 'var(--status-working)' }}>
      <div class="ig-step-head">
        <span class="ig-step-icon" aria-hidden="true">▤</span>
        <div>
          <p class="ig-step-kicker">02 · DECIDE</p>
          <h2>Server</h2>
        </div>
      </div>
      <p class="ig-eli5">Like the waiter deciding what to do with your order and passing it to the kitchen.</p>
      <div class="ig-step-grid">
        <div class="ig-step-block">
          <p class="ig-step-label">Real-world tools</p>
          <p>Node/Express, Django, Rails, Spring — runs on a server you control.</p>
        </div>
        <div class="ig-step-block">
          <p class="ig-step-label">When to use what</p>
          <p>Same query running over and over? Add a <strong>cache</strong> here, in front of the database. Task doesn't need to finish before responding? Hand it to a <strong>background job/queue</strong> instead of making the request wait.</p>
        </div>
        <div class="ig-step-block">
          <p class="ig-step-label">Under the hood — scaling</p>
          <p><strong>Stateless</strong> → any copy can answer any request, so a load balancer can spread traffic across many identical ones. "Routing" is matching a path to a handler, not magic — watch it happen in the live run below.</p>
          <div class="scale-diagram" role="img" aria-label="A load balancer distributing requests across four identical stateless server copies">
            <div class="scale-lb">Load balancer</div>
            <div class="scale-connector"></div>
            <div class="scale-copies">
              <div class="scale-copy">▤ copy 1</div>
              <div class="scale-copy">▤ copy 2</div>
              <div class="scale-copy">▤ copy 3</div>
              <div class="scale-copy">▤ copy 4</div>
            </div>
          </div>
        </div>
        <div class="ig-step-block">
          <p class="ig-step-label">Where AI fits in</p>
          <p>An LLM call is just another outbound request — same job (decide), one more thing the server waits on. An agent loop adds steps here, not new jobs — see <a href="/agentic-engineering/">Agentic Engineering</a>.</p>
        </div>
        <div class="ig-step-block cache-demo-block">
          <p class="ig-step-label">Cache in action — try it</p>
          <p class="cache-demo-note">The same query, run twice for real — not staged. The second run's trace never mentions the database at all.</p>
          <div class="cache-demo-controls">
            <button type="button" id="cache-run-btn" class="chip">Run query: <code>user:2</code></button>
            <button type="button" id="cache-clear-btn" class="chip">Clear cache</button>
            <span class="cache-status" id="cache-status"></span>
          </div>
          <div class="cache-trace" id="cache-trace" aria-live="polite"></div>
        </div>
        <div class="ig-step-block job-demo-block">
          <p class="ig-step-label">Response now, work later — try it</p>
          <p class="cache-demo-note">"Doesn't need to finish before responding" isn't hand-waving — the response line below appears immediately, then the job keeps going on its own.</p>
          <div class="cache-demo-controls">
            <button type="button" id="job-submit-btn" class="chip">Submit task: resize 500 images</button>
          </div>
          <p class="job-response" id="job-response"></p>
          <div class="cache-trace" id="job-trace" aria-live="polite"></div>
        </div>
      </div>
    </section>

    <section class="ig-step" id="database" style={{ '--step-accent': 'var(--accent-deep)' }}>
      <div class="ig-step-head">
        <span class="ig-step-icon" aria-hidden="true">▦</span>
        <div>
          <p class="ig-step-kicker">03 · STORE</p>
          <h2>Database</h2>
        </div>
      </div>
      <p class="ig-eli5">Like the kitchen — has the real ingredients, does the real work.</p>
      <div class="ig-step-grid">
        <div class="ig-step-block">
          <p class="ig-step-label">Real-world tools</p>
          <p>PostgreSQL, MySQL, MongoDB — where the real data actually lives.</p>
        </div>
        <div class="ig-step-block">
          <p class="ig-step-label">Under the hood</p>
          <p>Holds the <strong>one real copy</strong>, so it scales differently than the server (replication, sharding) — not just "add more copies."</p>
        </div>
        <div class="ig-step-block">
          <p class="ig-step-label">Where AI fits in</p>
          <p>A <strong>vector database</strong> is still "store" — a specialized tier for embeddings instead of rows, same job as here.</p>
        </div>
      </div>
      <div class="vs-grid">
        <div class="vs-col">
          <p class="vs-title">SQL — when records relate</p>
          <ul>
            <li>Fixed schema, rows &amp; columns</li>
            <li>Records relate to each other (orders → customers)</li>
            <li>Postgres, MySQL, SQLite</li>
          </ul>
        </div>
        <div class="vs-col">
          <p class="vs-title">NoSQL — when records stand alone</p>
          <ul>
            <li>Flexible schema, documents</li>
            <li>Each record stands alone, scales wide</li>
            <li>MongoDB, DynamoDB, Redis</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="ig-live">
      <p class="ig-kicker">See it happen — live</p>
      <div class="workspace-toolbar">
        <span class="workspace-title">request-lifecycle.sim</span>
        <span class="workspace-hint">genuinely tiny router + in-memory DB — type any id, or a made-up path</span>
      </div>

      <div class="pipeline" role="img" aria-label="Browser connects to Server over HTTP; Server connects to Database over SQL">
        <div class="pipe-node" data-node="browser">
          <span class="pipe-icon" aria-hidden="true">▣</span>
          <span class="pipe-name">Browser</span>
          <span class="pipe-note">Sends the request, renders the result</span>
        </div>
        <div class="pipe-edge" data-edge="browser-server"><span class="pipe-edge-note">HTTP</span></div>
        <div class="pipe-node" data-node="server">
          <span class="pipe-icon" aria-hidden="true">▤</span>
          <span class="pipe-name">Server</span>
          <span class="pipe-note">Stateless — could run 10 identical copies</span>
        </div>
        <div class="pipe-edge" data-edge="server-database"><span class="pipe-edge-note">SQL</span></div>
        <div class="pipe-node" data-node="database">
          <span class="pipe-icon" aria-hidden="true">▦</span>
          <span class="pipe-name">Database</span>
          <span class="pipe-note">Holds the one real copy — scales differently</span>
        </div>
      </div>

      <div class="addr-input-row">
        <span class="addr-proto">GET https://example.app</span>
        <input id="path-input" class="addr-input" type="text" value="/api/users/2" spellcheck="false" autocomplete="off" aria-label="Request path" />
        <button type="button" id="go-btn" class="go-btn">Go ▶</button>
      </div>
      <div class="preset-chips">
        <button type="button" class="chip" data-path="/api/users/1">user 1</button>
        <button type="button" class="chip" data-path="/api/users/2">user 2</button>
        <button type="button" class="chip" data-path="/api/users/99">user 99 (missing)</button>
        <button type="button" class="chip" data-path="/login">/login (bad route)</button>
      </div>

      <div class="tool-grid">
        <div class="tool-window">
          <div class="tool-titlebar"><span class="tw-dots"><i></i><i></i><i></i></span><span class="tw-tab">User Profile — browser</span></div>
          <div class="tool-body">
            <p class="net-log-label">Rendered page</p>
            <div class="rendered-page" id="rendered-page"><p class="rp-placeholder">Click Go or pick an example above.</p></div>
            <p class="net-log-label">Network</p>
            <div class="net-log" id="net-log" aria-live="polite"></div>
          </div>
        </div>

        <div class="tool-window">
          <div class="tool-titlebar"><span class="tw-dots"><i></i><i></i><i></i></span><span class="tw-tab">server.log — bash</span></div>
          <div class="tool-body terminal-body" id="log-server" aria-hidden="true"></div>
        </div>

        <div class="tool-window">
          <div class="tool-titlebar"><span class="tw-dots"><i></i><i></i><i></i></span><span class="tw-tab">query — users</span></div>
          <div class="tool-body" aria-hidden="true">
            <p class="net-log-label">Query</p>
            <div class="query-line" id="db-query">— no query yet —</div>
            <p class="net-log-label">Results</p>
            <table class="db-table" id="db-table" hidden>
              <thead><tr><th>id</th><th>name</th><th>role</th></tr></thead>
              <tbody id="db-tbody"></tbody>
            </table>
            <p class="db-empty" id="db-empty" hidden>0 rows returned</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ig-latency">
      <p class="ig-kicker">Relative speed — illustrative order, not measured</p>
      <div class="latency-bars">
        <div class="latency-row">
          <span class="latency-label">Cache hit</span>
          <div class="latency-track"><div class="latency-fill cache" style="width: 8%"></div></div>
          <span class="latency-value">&lt; 1ms</span>
        </div>
        <div class="latency-row">
          <span class="latency-label">Browser → Server (HTTP)</span>
          <div class="latency-track"><div class="latency-fill" style="width: 35%"></div></div>
          <span class="latency-value">~ms</span>
        </div>
        <div class="latency-row">
          <span class="latency-label">Server → Database (query)</span>
          <div class="latency-track"><div class="latency-fill db" style="width: 90%"></div></div>
          <span class="latency-value">~10–50ms</span>
        </div>
      </div>
      <p class="latency-caveat">Bar lengths show <em>order</em>, not real timings — the point is a cache hit skips the one hop that actually costs something, not the exact numbers.</p>
    </section>

    <section class="ig-recap">
      <p class="ig-kicker">Common misconceptions</p>
      <ul class="ig-recap-list">
        <li><strong>"The frontend talks to the database directly."</strong> Real stacks don't — the backend guards it.</li>
        <li><strong>"An error means the frontend is broken."</strong> Try user 99 above: the 404 starts at the database.</li>
        <li><strong>"More layers means worse."</strong> It's what lets a stack change one piece at a time.</li>
      </ul>
    </section>

    <section class="ig-compare">
      <p class="ig-kicker">Compare real stacks</p>
      <div class="digest-card">
        <p class="net-log-label">Popular stack combos</p>
        <div class="table-scroll">
          <table class="combo-table">
            <thead>
              <tr><th>Stack</th><th>▣ Frontend</th><th>▤ Backend</th><th>▦ Database</th></tr>
            </thead>
            <tbody>
              {STACK_COMBOS.map((s) => (
                <tr>
                  <td>{s.name}</td>
                  <td>{s.frontend.tool}</td>
                  <td>{s.backend.tool}</td>
                  <td>{s.database.tool}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="compare-card">
        <p class="net-log-label">What each part offers, and why you'd swap it</p>
        <div class="compare-chips">
          {STACK_COMBOS.map((s, i) => (
            <button type="button" class="chip compare-chip" data-stack-id={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.name}</button>
          ))}
        </div>
        <div class="compare-layers">
          <div class="compare-layer">
            <p class="compare-layer-label">▣ Frontend</p>
            <p class="compare-tool" id="compare-frontend-tool"></p>
            <p class="compare-offers" id="compare-frontend-offers"></p>
          </div>
          <div class="compare-layer">
            <p class="compare-layer-label">▤ Backend</p>
            <p class="compare-tool" id="compare-backend-tool"></p>
            <p class="compare-offers" id="compare-backend-offers"></p>
          </div>
          <div class="compare-layer">
            <p class="compare-layer-label">▦ Database</p>
            <p class="compare-tool" id="compare-database-tool"></p>
            <p class="compare-offers" id="compare-database-offers"></p>
          </div>
        </div>
        <p class="compare-swap"><span class="compare-swap-label">Swap out when:</span> <span id="compare-swap-text"></span></p>
      </div>
    </section>

  </div>

  <div class="footer-page">
    <RelatedTopics />

    <Sources
      sources={[
        {
          title: 'Client–server model — Wikipedia',
          url: 'https://en.wikipedia.org/wiki/Client%E2%80%93server_model',
          note: 'The foundational pattern every stack in this lab is built on.',
        },
        {
          title: 'Multitier architecture — Wikipedia',
          url: 'https://en.wikipedia.org/wiki/Multitier_architecture',
          note: 'The formal name for splitting frontend, backend, and database into separate tiers.',
        },
        {
          title: 'HTTP overview — MDN Web Docs',
          url: 'https://developer.mozilla.org/en-US/docs/Web/HTTP/Overview',
          note: 'The actual protocol the browser-to-server leg of this lab is modeling.',
        },
      ]}
    />
  </div>
</BaseLayout>

<script>
  import { scrambleText as decode } from '../lib/decode';
  import { handleRequest, type Layer } from '../lib/stack-sim';
  import { STACK_COMBOS, getStackCombo } from '../lib/stack-combos';
  import { runCachedQuery, resetCacheDemo } from '../lib/cache-demo';
  import { submitBackgroundJob } from '../lib/job-queue';

  const input = document.getElementById('path-input') as HTMLInputElement;
  const goBtn = document.getElementById('go-btn') as HTMLButtonElement;
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');

  const nodes: Record<Layer, HTMLElement> = {
    browser: document.querySelector<HTMLElement>('[data-node="browser"]')!,
    server: document.querySelector<HTMLElement>('[data-node="server"]')!,
    database: document.querySelector<HTMLElement>('[data-node="database"]')!,
  };
  const edges: Record<'browser-server' | 'server-database', HTMLElement> = {
    'browser-server': document.querySelector<HTMLElement>('[data-edge="browser-server"]')!,
    'server-database': document.querySelector<HTMLElement>('[data-edge="server-database"]')!,
  };

  const netLog = document.getElementById('net-log')!;
  const terminal = document.getElementById('log-server')!;
  const queryLine = document.getElementById('db-query')!;
  const dbTable = document.getElementById('db-table') as HTMLTableElement;
  const dbBody = document.getElementById('db-tbody')!;
  const dbEmpty = document.getElementById('db-empty')!;
  const renderedPage = document.getElementById('rendered-page')!;

  const LAYER_TAG: Record<Layer, string> = { browser: 'BR', server: 'SRV', database: 'DB' };

  let runTimer: number | undefined;

  function edgeKey(a: Layer, b: Layer): 'browser-server' | 'server-database' | undefined {
    const set = new Set([a, b]);
    if (set.has('browser') && set.has('server')) return 'browser-server';
    if (set.has('server') && set.has('database')) return 'server-database';
    return undefined;
  }

  function clearAll() {
    for (const el of Object.values(nodes)) el.classList.remove('active');
    for (const el of Object.values(edges)) el.classList.remove('active');
    netLog.innerHTML = '';
    terminal.innerHTML = '';
    queryLine.textContent = '— no query yet —';
    dbBody.innerHTML = '';
    dbEmpty.hidden = true;
    dbTable.hidden = true;
  }

  function renderOutcome(status: number, body: unknown) {
    renderedPage.innerHTML = '';
    if (status === 200 && body && typeof body === 'object') {
      const user = body as { id: number; name: string; role: string };
      const card = document.createElement('div');
      card.className = 'profile-card';
      const avatar = document.createElement('span');
      avatar.className = 'avatar';
      avatar.textContent = user.name.split(' ').map((w) => w[0]).join('');
      const name = document.createElement('span');
      name.className = 'p-name';
      name.textContent = user.name;
      const role = document.createElement('span');
      role.className = 'p-role';
      role.textContent = user.role;
      const id = document.createElement('span');
      id.className = 'p-id';
      id.textContent = `id: ${user.id}`;
      card.append(avatar, name, role, id);
      renderedPage.append(card);
    } else if (body && typeof body === 'object' && (body as { error?: string }).error === 'User not found') {
      const wrap = document.createElement('div');
      wrap.className = 'app-404';
      const glyph = document.createElement('span');
      glyph.className = 'app-404-glyph';
      glyph.textContent = '⌗';
      const p = document.createElement('p');
      p.textContent = 'User not found';
      wrap.append(glyph, p);
      renderedPage.append(wrap);
    } else {
      const wrap = document.createElement('div');
      wrap.className = 'browser-404';
      const glyph = document.createElement('span');
      glyph.className = 'browser-404-glyph';
      glyph.textContent = '✕';
      const p = document.createElement('p');
      p.textContent = "This page can't be found";
      wrap.append(glyph, p);
      renderedPage.append(wrap);
    }
  }

  function run(path: string) {
    if (runTimer) { clearTimeout(runTimer); runTimer = undefined; }
    clearAll();
    input.value = path;
    renderedPage.innerHTML = '<p class="rp-loading">loading…</p>';
    const result = handleRequest('GET', path);
    let seenDb = 0;
    let prevLayer: Layer | undefined;
    let i = 0;

    const step = () => {
      if (i >= result.log.length) {
        renderOutcome(result.status, result.body);
        return;
      }
      const entry = result.log[i];

      for (const el of Object.values(nodes)) el.classList.remove('active');
      for (const el of Object.values(edges)) el.classList.remove('active');
      nodes[entry.layer].classList.add('active');
      if (prevLayer && prevLayer !== entry.layer) {
        const key = edgeKey(prevLayer, entry.layer);
        if (key) edges[key].classList.add('active');
      }
      prevLayer = entry.layer;

      const line = document.createElement('p');
      line.className = 'sim-line';
      const tag = document.createElement('span');
      tag.className = `net-tag net-tag-${entry.layer}`;
      tag.textContent = LAYER_TAG[entry.layer];
      const textSpan = document.createElement('span');
      line.append(tag, document.createTextNode(' '), textSpan);
      netLog.append(line);
      netLog.scrollTop = netLog.scrollHeight;

      if (entry.layer === 'server') {
        const t = document.createElement('p');
        t.className = 'sim-line';
        terminal.append(t);
        decode(t, entry.text, { frames: 6, frameMs: 25 });
      }
      if (entry.layer === 'database') {
        seenDb++;
        if (seenDb === 1) {
          decode(queryLine, entry.text, { frames: 6, frameMs: 25 });
        } else if (seenDb === 2) {
          if (result.status === 200) {
            const user = result.body as { id: number; name: string; role: string };
            dbTable.hidden = false;
            dbEmpty.hidden = true;
            const tr = document.createElement('tr');
            for (const val of [user.id, user.name, user.role]) {
              const td = document.createElement('td');
              td.textContent = String(val);
              tr.append(td);
            }
            dbBody.append(tr);
          } else {
            dbTable.hidden = true;
            dbEmpty.hidden = false;
          }
        }
      }

      decode(textSpan, entry.text, { frames: 6, frameMs: 25, onDone: () => {
        i++;
        runTimer = window.setTimeout(step, 340);
      }});
    };
    step();
  }

  goBtn.addEventListener('click', () => run(input.value.trim() || '/api/users/1'));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); run(input.value.trim() || '/api/users/1'); }
  });
  chips.forEach((chip) => chip.addEventListener('click', () => run(chip.dataset.path ?? '')));

  const compareChips = document.querySelectorAll<HTMLButtonElement>('.compare-chip');
  const compareEls = {
    frontendTool: document.getElementById('compare-frontend-tool')!,
    frontendOffers: document.getElementById('compare-frontend-offers')!,
    backendTool: document.getElementById('compare-backend-tool')!,
    backendOffers: document.getElementById('compare-backend-offers')!,
    databaseTool: document.getElementById('compare-database-tool')!,
    databaseOffers: document.getElementById('compare-database-offers')!,
    swap: document.getElementById('compare-swap-text')!,
  };

  function showStack(id: string) {
    const stack = getStackCombo(id);
    if (!stack) return;
    compareChips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.stackId === id)));
    decode(compareEls.frontendTool, stack.frontend.tool, { frames: 6, frameMs: 25 });
    compareEls.frontendOffers.textContent = stack.frontend.offers;
    decode(compareEls.backendTool, stack.backend.tool, { frames: 6, frameMs: 25 });
    compareEls.backendOffers.textContent = stack.backend.offers;
    decode(compareEls.databaseTool, stack.database.tool, { frames: 6, frameMs: 25 });
    compareEls.databaseOffers.textContent = stack.database.offers;
    compareEls.swap.textContent = stack.swapWhen;
  }

  compareChips.forEach((chip) => chip.addEventListener('click', () => showStack(chip.dataset.stackId ?? '')));
  showStack(STACK_COMBOS[0].id);

  const cacheRunBtn = document.getElementById('cache-run-btn') as HTMLButtonElement;
  const cacheClearBtn = document.getElementById('cache-clear-btn') as HTMLButtonElement;
  const cacheStatus = document.getElementById('cache-status')!;
  const cacheTrace = document.getElementById('cache-trace')!;
  let cacheRunTimer: number | undefined;

  function runCacheDemoStep() {
    if (cacheRunTimer) { clearTimeout(cacheRunTimer); cacheRunTimer = undefined; }
    const result = runCachedQuery('user:2');
    cacheTrace.innerHTML = '';
    cacheStatus.textContent = result.hit ? 'HIT' : 'MISS';
    cacheStatus.className = `cache-status ${result.hit ? 'hit' : 'miss'}`;
    let i = 0;
    const step = () => {
      if (i >= result.steps.length) return;
      const line = document.createElement('p');
      line.className = 'cache-trace-line';
      cacheTrace.append(line);
      decode(line, result.steps[i], { frames: 6, frameMs: 25, onDone: () => {
        i++;
        cacheRunTimer = window.setTimeout(step, 260);
      }});
    };
    step();
  }

  cacheRunBtn.addEventListener('click', runCacheDemoStep);
  cacheClearBtn.addEventListener('click', () => {
    if (cacheRunTimer) { clearTimeout(cacheRunTimer); cacheRunTimer = undefined; }
    resetCacheDemo();
    cacheTrace.innerHTML = '';
    cacheStatus.textContent = '';
    cacheStatus.className = 'cache-status';
  });

  const jobSubmitBtn = document.getElementById('job-submit-btn') as HTMLButtonElement;
  const jobResponse = document.getElementById('job-response')!;
  const jobTrace = document.getElementById('job-trace')!;
  let jobRunTimer: number | undefined;

  jobSubmitBtn.addEventListener('click', () => {
    if (jobRunTimer) { clearTimeout(jobRunTimer); jobRunTimer = undefined; }
    const { immediateResponse, backgroundSteps } = submitBackgroundJob('resize 500 images');
    jobTrace.innerHTML = '';
    decode(jobResponse, immediateResponse, { frames: 6, frameMs: 25 });
    let i = 0;
    const step = () => {
      if (i >= backgroundSteps.length) return;
      const line = document.createElement('p');
      line.className = 'cache-trace-line';
      jobTrace.append(line);
      decode(line, backgroundSteps[i], { frames: 6, frameMs: 25, onDone: () => {
        i++;
        jobRunTimer = window.setTimeout(step, 500);
      }});
    };
    jobRunTimer = window.setTimeout(step, 400);
  });
</script>

