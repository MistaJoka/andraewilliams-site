---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sources from '../components/Sources.astro';
import RelatedTopics from '../components/RelatedTopics.astro';
import VerifiedDate from '../components/VerifiedDate.astro';
import { LAYERS, TASKS, TOGGLE_BLOCKS, SCENARIOS, APP_SHAPE_SCENARIOS } from '../lib/architecture';

const STEPS = [
  { id: 'step-1', num: '1', label: 'Where it lives' },
  { id: 'step-2', num: '2', label: 'Wiring in AI' },
  { id: 'step-3', num: '3', label: 'Choosing options' },
  { id: 'step-4', num: '4', label: 'Shaping a new app' },
];
---
<BaseLayout
  title="Architecture"
  description="Why the same task can touch one file or ten, how an AI pipeline is actually wired, how to weigh real architectural tradeoffs, and how to shape a brand-new app — one continuous, interactive walkthrough."
>
  <p class="eyebrow"><a href="/systems/">← Systems</a></p>
  <h1>Architecture</h1>
  <VerifiedDate />

  <section class="hero-digest">
    <p class="digest-kicker">The big picture — click a step to jump to it</p>
    <ul class="digest-list">
      <li>Architecture is <strong>where a decision lives</strong>, not how many layers you drew.</li>
      <li>An "AI pipeline" is a normal request path with an <strong>LLM as one more block</strong> in it.</li>
      <li>There's rarely one right architecture — only <strong>real tradeoffs</strong> given real constraints.</li>
      <li>A new app's shape should follow <strong>its actual scale and team size</strong> — monolith-first is usually the right call, not a compromise.</li>
    </ul>
  </section>

  <nav class="process-map" aria-label="Page sections">
    {STEPS.map((s, i) => (
      <>
        <a href={`#${s.id}`} class="map-step" data-step={s.num}>
          <span class="map-num">{s.num}</span>
          <span class="map-label">{s.label}</span>
        </a>
        {i < STEPS.length - 1 && <span class="map-connector" aria-hidden="true"></span>}
      </>
    ))}
  </nav>

  <div class="flow-page">
    <div class="flow-steps">

      <section class="flow-step" id="step-1" data-step-section="1">
        <div class="step-marker"><span class="step-num">1</span></div>
        <div class="step-body">
          <h2>Where a decision lives</h2>
          <p class="step-intro">
            A change's "blast radius" is every file it forces you to
            touch — not a metaphor, a countable thing. Clean boundaries keep
            that count low and predictable; leaked logic doesn't. Pick a
            task, flip the boundary quality, watch which layers light up.
          </p>

          <div class="control-row">
            <label class="control-label" for="task-select">Task</label>
            <select id="task-select" class="select-input">
              {TASKS.map((t) => <option value={t.id}>{t.title}</option>)}
            </select>
          </div>

          <div class="control-row">
            <span class="control-label">Boundary quality</span>
            <div class="segmented" role="radiogroup" aria-label="Boundary quality">
              <button type="button" class="seg-btn active" data-quality="clean" role="radio" aria-checked="true">Clean layering</button>
              <button type="button" class="seg-btn" data-quality="tangled" role="radio" aria-checked="false">Tangled boundaries</button>
            </div>
          </div>

          <div class="layer-stack" role="img" aria-label="UI, API, service, and data layers">
            {LAYERS.map((l) => (
              <div class="layer-node" data-layer={l.id}>
                <span class="layer-name">{l.name}</span>
              </div>
            ))}
          </div>

          <p class="blast-note" id="blast-note"></p>

          <p class="step-why">
            An AI coding agent works from whatever files it can see — small
            blast radius means small context, means a safer edit. A tangled
            boundary inflates exactly the window an agent has to reason over.
          </p>
        </div>
      </section>

      <section class="flow-step" id="step-2" data-step-section="2">
        <div class="step-marker"><span class="step-num">2</span></div>
        <div class="step-body">
          <h2>Wiring in AI</h2>
          <p class="step-intro">
            An "AI pipeline" is a normal request path with an LLM somewhere
            in it. Client and API are fixed; everything behind the gateway
            is a choice. Toggle what's wired in, run a request — an invalid
            combination fails with a real reason, not a canned error.
          </p>

          <div class="toggle-row">
            {TOGGLE_BLOCKS.map((b) => (
              <div class="toggle-item">
                <button type="button" class="toggle-chip" data-block={b.id} aria-pressed="false">{b.name}</button>
                <p class="toggle-hint">{b.whenToUse}</p>
              </div>
            ))}
          </div>

          <div class="pipeline" role="img" aria-label="Client, API gateway, and toggleable blocks behind it">
            <div class="pipe-node fixed active" data-pnode="client"><span class="pipe-icon" aria-hidden="true">▣</span><span class="pipe-name">Client</span></div>
            <div class="pipe-edge"></div>
            <div class="pipe-node fixed" data-pnode="api"><span class="pipe-icon" aria-hidden="true">▤</span><span class="pipe-name">API</span></div>
            <div class="pipe-edge"></div>
            <div class="pipe-node dim" data-pnode="orchestrator"><span class="pipe-icon" aria-hidden="true">◆</span><span class="pipe-name">Orchestrator</span></div>
            <div class="pipe-edge"></div>
            <div class="pipe-node dim" data-pnode="llm"><span class="pipe-icon" aria-hidden="true">✦</span><span class="pipe-name">LLM</span></div>
          </div>
          <div class="pipeline-extra">
            <div class="pipe-node dim small" data-pnode="retrieval"><span class="pipe-name">Retrieval</span></div>
            <div class="pipe-node dim small" data-pnode="tools"><span class="pipe-name">Tools</span></div>
          </div>

          <div class="generate-row">
            <button type="button" id="run-pipeline-btn" class="ex-btn">Run request →</button>
          </div>
          <div class="trace-log" id="pipeline-log" aria-live="polite"></div>

          <p class="step-why">
            Wiring in an LLM is still a systems-design problem first — where
            the call lives changes latency, cost, and who can reuse it. Run
            with no orchestrator above: still a valid, ordinary endpoint.
          </p>
        </div>
      </section>

      <section class="flow-step" id="step-3" data-step-section="3">
        <div class="step-marker"><span class="step-num">3</span></div>
        <div class="step-body">
          <h2>Choosing between real options</h2>
          <p class="step-intro">
            There's rarely one right architecture — only real tradeoffs
            given real constraints. Pick a scenario, then weigh the options
            side by side.
          </p>

          <div class="control-row">
            <label class="control-label" for="scenario-select">Scenario</label>
            <select id="scenario-select" class="select-input">
              {SCENARIOS.map((s) => <option value={s.id}>{s.title}</option>)}
            </select>
          </div>
          <p class="scenario-prompt" id="scenario-prompt"></p>

          <div class="options-grid" id="options-grid"></div>

          <p class="step-why">
            All three are viable. The right one depends on constraints a
            diagram won't show you — traffic, team size, latency tolerance.
          </p>
        </div>
      </section>

      <section class="flow-step" id="step-4" data-step-section="4">
        <div class="step-marker"><span class="step-num">4</span></div>
        <div class="step-body">
          <h2>Shaping a new app</h2>
          <p class="step-intro">
            One level earlier than the rest of this page: before there's a
            codebase to fix or an AI pipeline to wire in, there's the shape
            of the app itself. Pick a scenario, weigh the options.
          </p>

          <div class="control-row">
            <label class="control-label" for="shape-scenario-select">Scenario</label>
            <select id="shape-scenario-select" class="select-input">
              {APP_SHAPE_SCENARIOS.map((s) => <option value={s.id}>{s.title}</option>)}
            </select>
          </div>
          <p class="scenario-prompt" id="shape-scenario-prompt"></p>

          <div class="options-grid" id="shape-options-grid"></div>

          <p class="step-why">
            Monolith-first isn't a compromise — it's usually correct.
            Microservices pay off once a team or a hot path actually needs
            independent scaling, not before.
          </p>
        </div>
      </section>

    </div>

    <section class="flow-recap">
      <div class="recap-grid">
        <div class="recap-card">
          <p class="docs-label">When to use what</p>
          <ul>
            <li>Knowing the pieces isn't the skill — knowing <strong>which one a given task actually needs</strong> is. That judgment call is what the four steps above are for.</li>
            <li><strong>Plain endpoint, no LLM:</strong> the task is deterministic. Don't reach for a model because you can.</li>
            <li><strong>+ Orchestrator + LLM:</strong> the task needs judgment or language generation the model already knows how to do.</li>
            <li><strong>+ Retrieval:</strong> the model needs facts it wasn't trained on — your docs, your data, anything that changes after training.</li>
            <li><strong>+ Tools:</strong> the model needs to <em>do</em> something, not just say something.</li>
            <li><strong>Invest in clean layering</strong> exactly where more than one kind of change — or reader, human or agent — will touch that code again.</li>
            <li><strong>Start monolith, split later:</strong> a service boundary you don't need yet is pure overhead — extract only once something specific actually needs independent scaling.</li>
          </ul>
        </div>
        <div class="recap-card">
          <p class="docs-label">Failure modes</p>
          <ul>
            <li><strong>"More layers is always better."</strong> Step 1's phone-number task shows a case where wide blast radius is correct, not a smell.</li>
            <li><strong>"Adding an LLM call makes it an AI pipeline."</strong> Step 2 with no orchestrator is a valid, ordinary endpoint that happens to exist.</li>
            <li><strong>"There's one right architecture."</strong> Step 3's options are all viable — the right one depends on constraints the diagram alone won't show you.</li>
            <li><strong>"Microservices are the mature choice."</strong> Step 4's straining-monolith scenario shows staying monolith and investing in boundaries is often the better call.</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <div class="footer-page">
    <RelatedTopics />

    <Sources
      sources={[
        {
          title: 'Multitier architecture — Wikipedia',
          url: 'https://en.wikipedia.org/wiki/Multitier_architecture',
          note: 'The layered split Step 1 is built on.',
        },
        {
          title: 'Hexagonal architecture (ports and adapters) — Alistair Cockburn',
          url: 'https://alistair.cockburn.us/hexagonal-architecture/',
          note: 'The general principle behind keeping business logic isolated from any one boundary — why a "tangled" version of a task spreads further.',
        },
        {
          title: 'Retrieval-augmented generation (RAG) — original paper',
          url: 'https://arxiv.org/abs/2005.11401',
          note: 'What Step 2\'s "retrieval" block is actually modeling.',
        },
        {
          title: 'Model Context Protocol',
          url: 'https://modelcontextprotocol.io',
          note: 'The real standard for how an orchestrator hands tool access to an LLM, modeled by Step 2\'s "tools" block.',
        },
        {
          title: 'MonolithFirst — Martin Fowler',
          url: 'https://martinfowler.com/bliki/MonolithFirst.html',
          note: 'The argument behind Step 4: start monolith, split out services once you actually know where the boundaries belong.',
        },
      ]}
    />
  </div>
</BaseLayout>

<script>
  import { scrambleText as decode } from '../lib/decode';
  import {
    getBlastRadius, runPipeline, getScenario, getAppShapeScenario, LAYERS,
    type LayerId, type BoundaryQuality, type ToggleBlockId, type PipelineBlock, type Scenario,
  } from '../lib/architecture';

  // ---- Step 1: blast radius ----
  const taskSelect = document.getElementById('task-select') as HTMLSelectElement;
  const qualityBtns = document.querySelectorAll<HTMLButtonElement>('.seg-btn');
  const layerNodes: Record<LayerId, HTMLElement> = {} as Record<LayerId, HTMLElement>;
  for (const l of LAYERS) layerNodes[l.id] = document.querySelector<HTMLElement>(`[data-layer="${l.id}"]`)!;
  const blastNote = document.getElementById('blast-note')!;
  let quality: BoundaryQuality = 'clean';

  function renderBlastRadius() {
    for (const el of Object.values(layerNodes)) el.classList.remove('active');
    const { layers, note } = getBlastRadius(taskSelect.value, quality);
    for (const id of layers) layerNodes[id].classList.add('active');
    decode(blastNote, `${layers.length} of ${LAYERS.length} layers touched — ${note}`, { frames: 5, frameMs: 20 });
  }

  taskSelect.addEventListener('change', renderBlastRadius);
  qualityBtns.forEach((btn) => btn.addEventListener('click', () => {
    quality = btn.dataset.quality as BoundaryQuality;
    qualityBtns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-checked', String(b === btn)); });
    renderBlastRadius();
  }));
  renderBlastRadius();

  // ---- Step 2: AI pipeline ----
  const toggleChips = document.querySelectorAll<HTMLButtonElement>('.toggle-chip');
  const enabled = new Set<ToggleBlockId>();
  const pipeNodes: Record<PipelineBlock, HTMLElement> = {
    client: document.querySelector('[data-pnode="client"]')!,
    api: document.querySelector('[data-pnode="api"]')!,
    orchestrator: document.querySelector('[data-pnode="orchestrator"]')!,
    llm: document.querySelector('[data-pnode="llm"]')!,
    retrieval: document.querySelector('[data-pnode="retrieval"]')!,
    tools: document.querySelector('[data-pnode="tools"]')!,
  };
  const pipelineLog = document.getElementById('pipeline-log')!;
  const runPipelineBtn = document.getElementById('run-pipeline-btn') as HTMLButtonElement;
  let pipelineTimer: number | undefined;
  // Bumped on every run so a still-animating decode() from a superseded
  // run (its own internal timer, not `pipelineTimer`) can tell it's
  // stale and stop instead of appending a stray row into the next run's
  // already-cleared log.
  let pipelineRunId = 0;

  toggleChips.forEach((chip) => chip.addEventListener('click', () => {
    const id = chip.dataset.block as ToggleBlockId;
    const on = !enabled.has(id);
    if (on) enabled.add(id); else enabled.delete(id);
    chip.setAttribute('aria-pressed', String(on));
    chip.classList.toggle('active', on);
    pipeNodes[id].classList.toggle('dim', !on);
    pipeNodes[id].classList.toggle('active', on);
  }));

  function runPipelineLab() {
    if (pipelineTimer) { clearTimeout(pipelineTimer); pipelineTimer = undefined; }
    const runId = ++pipelineRunId;
    pipelineLog.innerHTML = '';
    for (const [id, el] of Object.entries(pipeNodes)) {
      if (id === 'client' || id === 'api') continue;
      el.classList.remove('running');
    }
    const result = runPipeline(enabled);

    if (!result.valid) {
      const row = document.createElement('div');
      row.className = 'trace-row trace-error';
      row.textContent = `✕ ${result.error}`;
      pipelineLog.append(row);
      return;
    }

    let i = 0;
    const step = () => {
      if (runId !== pipelineRunId) return;
      for (const el of Object.values(pipeNodes)) el.classList.remove('running');
      if (i >= result.log.length) return;
      const entry = result.log[i];
      pipeNodes[entry.block].classList.add('running');
      const row = document.createElement('div');
      row.className = 'trace-row';
      const label = document.createElement('span');
      label.className = 'trace-label';
      label.textContent = entry.block.toUpperCase();
      const text = document.createElement('span');
      text.className = 'trace-text';
      row.append(label, text);
      pipelineLog.append(row);
      pipelineLog.scrollTop = pipelineLog.scrollHeight;
      decode(text, entry.text, { frames: 5, frameMs: 20, onDone: () => {
        if (runId !== pipelineRunId) return;
        i++;
        pipelineTimer = window.setTimeout(step, 260);
      }});
    };
    step();
  }
  runPipelineBtn.addEventListener('click', runPipelineLab);

  // ---- Step 3 & 4: compare (shared renderer -- same Scenario shape,
  // two independent pickers so choosing one never touches the other) ----
  function bindScenarioPicker(selectId: string, promptId: string, gridId: string, lookup: (id: string) => Scenario) {
    const select = document.getElementById(selectId) as HTMLSelectElement;
    const prompt = document.getElementById(promptId)!;
    const grid = document.getElementById(gridId)!;

    function render() {
      const scenario = lookup(select.value);
      prompt.textContent = scenario.prompt;
      grid.innerHTML = '';
      for (const opt of scenario.options) {
        const card = document.createElement('div');
        card.className = 'option-card';
        const title = document.createElement('p');
        title.className = 'option-title';
        title.textContent = opt.title;
        const summary = document.createElement('p');
        summary.className = 'option-summary';
        summary.textContent = opt.summary;
        const pros = document.createElement('ul');
        pros.className = 'option-list pros';
        for (const p of opt.pros) { const li = document.createElement('li'); li.textContent = p; pros.append(li); }
        const cons = document.createElement('ul');
        cons.className = 'option-list cons';
        for (const c of opt.cons) { const li = document.createElement('li'); li.textContent = c; cons.append(li); }
        card.append(title, summary, pros, cons);
        grid.append(card);
      }
    }
    select.addEventListener('change', render);
    render();
  }

  bindScenarioPicker('scenario-select', 'scenario-prompt', 'options-grid', getScenario);
  bindScenarioPicker('shape-scenario-select', 'shape-scenario-prompt', 'shape-options-grid', getAppShapeScenario);

  // ---- Process map: scroll-spy + click-to-jump ----
  const mapSteps = document.querySelectorAll<HTMLAnchorElement>('.map-step');
  const stepSections = document.querySelectorAll<HTMLElement>('.flow-step');

  function setActiveMapStep(num: string) {
    mapSteps.forEach((el) => el.classList.toggle('active', el.dataset.step === num));
  }
  setActiveMapStep('1');

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const num = (entry.target as HTMLElement).dataset.stepSection!;
        setActiveMapStep(num);
      }
    }
  }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
  stepSections.forEach((section) => observer.observe(section));
</script>

<style>
  .hero-digest {
    border: 1px solid var(--line-bright); background: var(--bg-1); padding: var(--sp-4);
    max-width: 62rem; margin: var(--sp-3) 0 var(--sp-5);
  }
  .digest-kicker { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-2); margin: 0 0 var(--sp-3); }
  .digest-list { margin: 0; padding-left: 1.2rem; display: grid; gap: var(--sp-2); font-size: var(--step-0); line-height: 1.5; color: var(--text-1); }
  .digest-list strong { color: var(--text-0); }

  /* The high-level map: a persistent, clickable overview of the three
     steps below, always visible while scrolling -- the "understand it
     at a high level, at any point" piece of this page. */
  .process-map {
    position: sticky; top: 0; z-index: 5;
    display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
    background: var(--bg-0); border-bottom: 1px solid var(--line);
    padding: var(--sp-3) var(--sp-4); margin: 0 0 var(--sp-6);
    flex-wrap: wrap;
  }
  .map-step {
    display: flex; align-items: center; gap: var(--sp-2); text-decoration: none;
    padding: var(--sp-1) var(--sp-2); color: var(--text-2); transition: color 150ms ease-out;
  }
  .map-step:hover { color: var(--text-0); }
  .map-num {
    width: 1.6rem; height: 1.6rem; flex-shrink: 0; border-radius: 50%; border: 1px solid var(--line-bright);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; transition: all 150ms ease-out;
  }
  .map-label { font-family: var(--font-mono); font-size: 0.72rem; white-space: nowrap; }
  .map-step.active { color: var(--accent); }
  .map-step.active .map-num { border-color: var(--accent); background: var(--accent); color: var(--bg-0); }
  .map-connector { width: 2rem; height: 1px; background: var(--line-bright); flex-shrink: 0; }
  @media (max-width: 34rem) { .map-label { display: none; } }

  .flow-page {
    position: relative; left: 50%; transform: translateX(-50%);
    width: 100vw; max-width: 62rem; box-sizing: border-box;
    padding: 0 var(--sp-5);
    margin: 0 0 var(--sp-6);
  }

  /* The connecting spine: one continuous line behind all three numbered
     markers, so the page reads as one process, not three unrelated
     widgets stacked on a page. */
  .flow-steps { position: relative; display: grid; gap: var(--sp-7); }
  .flow-steps::before {
    content: ''; position: absolute; left: 1.25rem; top: 1.25rem; bottom: 1.25rem;
    width: 2px; background: var(--line-bright); z-index: 0;
  }

  .flow-step { position: relative; display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--sp-4); }
  @media (max-width: 40rem) { .flow-step { grid-template-columns: 2rem 1fr; } }
  .step-marker { display: flex; justify-content: center; }
  .step-num {
    width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--accent);
    background: var(--bg-0); color: var(--accent); z-index: 1;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: var(--step-0); font-weight: 700;
  }
  @media (max-width: 40rem) { .step-num { width: 2rem; height: 2rem; font-size: var(--step--1); } }

  .step-body { min-width: 0; display: grid; gap: var(--sp-3); border: 1px solid var(--line); background: var(--bg-1); padding: var(--sp-4); }
  .step-body h2 { margin: 0; }
  .step-intro { color: var(--text-1); margin: 0; }
  .step-why { color: var(--text-2); font-size: var(--step--1); margin: 0; padding-top: var(--sp-2); border-top: 1px solid var(--line); }

  .control-row { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
  .control-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.06em; }
  .select-input {
    font-family: var(--font-mono); font-size: 0.78rem; padding: var(--sp-2); flex: 1; min-width: 14rem;
    background: var(--bg-0); border: 1px solid var(--line-bright); color: var(--text-0);
  }
  .segmented { display: flex; gap: 0; border: 1px solid var(--line-bright); }
  .seg-btn { font-family: var(--font-mono); font-size: 0.7rem; padding: var(--sp-2) var(--sp-3); background: var(--bg-0); border: none; color: var(--text-1); cursor: pointer; }
  .seg-btn + .seg-btn { border-left: 1px solid var(--line-bright); }
  .seg-btn.active { background: var(--accent); color: var(--bg-0); font-weight: 700; }

  /* step 1 layer stack */
  .layer-stack { display: grid; gap: var(--sp-2); }
  .layer-node {
    padding: var(--sp-3); border: 1px solid var(--line-bright); background: var(--bg-0);
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-1); transition: all 150ms ease-out;
  }
  .layer-node.active { border-color: var(--status-broken); color: var(--text-0); box-shadow: 0 0 0 1px var(--status-broken), 0 0 16px color-mix(in srgb, var(--status-broken) 35%, transparent); }
  .blast-note { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-1); padding: var(--sp-3); background: var(--bg-0); border: 1px solid var(--line); min-height: 2.5rem; margin: 0; }

  /* step 2 pipeline */
  .toggle-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: var(--sp-3); }
  .toggle-item { display: grid; gap: var(--sp-1); align-content: start; }
  .toggle-chip { font-family: var(--font-mono); font-size: 0.72rem; padding: var(--sp-2) var(--sp-3); background: var(--bg-0); border: 1px solid var(--line); color: var(--text-1); cursor: pointer; }
  .toggle-chip:hover { border-color: var(--accent); }
